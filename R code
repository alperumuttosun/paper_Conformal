    German = fx(sel9(rs, lang = "deu")$min_rank_cor_between_L), `All 47 authors` = "", check.names = FALSE))

  ## ---- S6 (Supplementary Table S7): authors with two vs three or more novels ----
  ntc <- nt[nt$metric == "covered" & nt$weight == "chunk", ]
  S6 <- do.call(rbind, lapply(c("fra", "deu", "eng"), function(lg) do.call(rbind, lapply(L_set, function(L)
