set.seed(2028)                                                # step04 has its own seed
LANGS   <- c("eng", "fra", "deu")                             # languages analysed
B_REP4  <- 100                                                # subsamples for rep_sub
N_SPLIT4 <- 3                                                 # repeats of chunk-level split
L_HET   <- 2000                                               # chunk length for heterogeneity
