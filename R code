f07  <- file.path(out_dir, "step07_main_results.xlsx")         # step07 output (fold-wise MFW)
use07 <- file.exists(f07)                                     # TRUE after step07 has run
cat("STEP 05 figures from:", if (use07) "step07 (MFW chosen inside each fold)" else "step04", "\n")
cb5  <- if (use07) read_sheet(f07, "closed_main") else read_sheet(f04, "closed_boot")        # closed set with CIs
