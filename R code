## =====================================================================
## STEP 02 - Chunks, Cosine Delta scores, conformal sets
## Methods for calibration scores:
##   naive        : author profile INCLUDES the chunk's own novel (ignores book clustering)
##   crossfit_all : profile EXCLUDES the chunk's own novel, all chunks used
##   crossfit_one : as crossfit_all, but ONE random chunk per novel (novel-level exchangeability)
## =====================================================================
N_MFW <- 200                                                  # most frequent words used
L_set <- c(250, 500, 1000, 2000, 5000)                        # chunk lengths (words)
CAP   <- 30                                                   # max chunks per novel
ALPHA <- 0.10                                                 # target miscoverage (90% sets)

all_cand <- unlist(toks[corp$role == "candidate"], use.names = FALSE)  # candidate tokens
mfw <- names(sort(table(all_cand), decreasing = TRUE))[1:N_MFW]        # MFW list
rm(all_cand)                                                  # free memory

## ---- cut a novel into non-overlapping contiguous chunks ----
make_chunks <- function(w, L, cap) {
  k <- floor(length(w) / L)                                   # number of full chunks
  if (k < 1) return(list())                                   # novel too short
  idx <- seq_len(k)                                           # chunk positions
  if (k > cap) idx <- sort(sample(idx, cap))                  # random subset if too many
  lapply(idx, function(j) w[((j - 1) * L + 1):(j * L)])       # chunk word vectors
}

## ---- conformal quantile with finite-sample correction ----
qconf <- function(s, a) {
  s <- s[is.finite(s)]                                        # drop missing scores
  n <- length(s)                                              # calibration size
  k <- ceiling((n + 1) * (1 - a))                             # conformal rank
  if (n == 0 || k > n) return(Inf) else sort(s)[k]            # Inf = include every author
}

## ---- cosine distance between rows of Z and rows of P ----
cosd <- function(Z, P) {
  Zn <- Z / sqrt(rowSums(Z^2))                                # unit-length chunks
  Pn <- P / sqrt(rowSums(P^2))                                # unit-length profiles
  1 - Zn %*% t(Pn)                                            # chunk x author distance
}

## ---- step02 runs only if its output does not exist yet (already done -> skipped) ----
f02 <- file.path(out_dir, "step02_conformal_results.xlsx")    # step02 output file
if (!file.exists(f02)) {
  res_closed <- list()                                          # closed-set results
  res_open   <- list()                                          # open-set results

  for (L in L_set) {
    cat("Chunk length L =", L, "\n")                            # progress

    ## ---- build chunk feature matrix ----
    ch_list <- lapply(corp$id, function(id) make_chunks(toks[[id]], L, CAP))  # chunks per novel
    n_ch <- lengths(ch_list)                                    # chunks per novel
    meta <- data.frame(id = rep(corp$id, n_ch),
                       author = rep(corp$author, n_ch),
                       role = rep(corp$role, n_ch), stringsAsFactors = FALSE)  # chunk metadata
    X <- do.call(rbind, lapply(unlist(ch_list, recursive = FALSE),
           function(ch) tabulate(match(ch, mfw), nbins = N_MFW) / L))  # relative MFW frequencies
    rm(ch_list)                                                 # free memory

    ## ---- helper: z-score with stats from training rows only ----
    zfit <- function(tr) {
      mu <- colMeans(X[tr, , drop = FALSE])                     # feature means
      sdv <- apply(X[tr, , drop = FALSE], 2, sd)                # feature sds
      sdv[!is.finite(sdv) | sdv == 0] <- 1                      # guard zero sd
      sweep(sweep(X, 2, mu), 2, sdv, "/")                       # z-scores for all rows
    }

    ## ---- helper: calibration scores and profiles from candidate rows ----
    calib <- function(Z, trc) {
      S <- rowsum(Z[trc, , drop = FALSE], meta$id[trc])        # sum of z per novel
      cnt <- as.vector(table(meta$id[trc])[rownames(S)])        # chunks per novel
      na <- corp$author[match(rownames(S), corp$id)]            # author of each novel
      Sa <- rowsum(S, na)                                       # sum per author
      Na <- tapply(cnt, na, sum)[rownames(Sa)]                  # chunks per author
      P <- Sa / as.vector(Na)                                   # full author profiles
      Zt <- Z[trc, , drop = FALSE]                              # candidate training chunks
      D0 <- cosd(Zt, P)                                         # distance to every profile
      s_naive <- D0[cbind(seq_len(nrow(Zt)), match(meta$author[trc], rownames(P)))]  # own author, own novel inside
      s_cf <- rep(NA_real_, nrow(Zt))                           # cross-fit scores
      idt <- meta$id[trc]                                       # novel id per chunk
      for (m in rownames(S)) {                                  # leave one novel out
        a <- na[rownames(S) == m]                               # its author
        nleft <- Na[a] - cnt[rownames(S) == m]                  # chunks left for profile
        if (nleft <= 0) next                                    # author has no other novel
        pm <- (Sa[a, ] - S[m, ]) / nleft                        # profile without this novel
        ii <- which(idt == m)                                   # chunks of this novel
        zi <- Zt[ii, , drop = FALSE]                            # their z-scores
        s_cf[ii] <- 1 - (zi %*% pm) / (sqrt(rowSums(zi^2)) * sqrt(sum(pm^2)))  # cosine distance
      }
      ok <- which(is.finite(s_cf))                              # usable cross-fit chunks
      one <- tapply(ok, idt[ok], function(v) v[sample.int(length(v), 1)])  # one chunk per novel
      list(P = P,
           q = c(naive = qconf(s_naive, ALPHA),
                 crossfit_all = qconf(s_cf, ALPHA),
                 crossfit_one = qconf(s_cf[unlist(one)], ALPHA)))  # three conformal thresholds
    }

    ## ---- CLOSED SET: leave one candidate novel out ----
    for (nstar in corp$id[corp$role == "candidate"]) {
      te <- which(meta$id == nstar)                             # test chunks
      if (length(te) == 0) next                                 # novel shorter than L
      tr <- meta$id != nstar                                    # training rows
      Z <- zfit(tr)                                             # z-scores from training rows
      trc <- tr & meta$role == "candidate"                      # candidate training rows
      cb <- calib(Z, trc)                                       # profiles and thresholds
      true_a <- meta$author[te[1]]                              # true author
      if (!(true_a %in% rownames(cb$P))) next                   # author has no other novel
      D <- cosd(Z[te, , drop = FALSE], cb$P)                    # test distances
      for (mth in names(cb$q)) {                                # each calibration method
        inset <- D <= cb$q[mth]                                 # prediction set membership
        res_closed[[length(res_closed) + 1]] <- data.frame(
          L = L, method = mth, novel = nstar, author = true_a,
          chunk = seq_along(te),
          covered = inset[, true_a],                            # true author in set?
          set_size = rowSums(inset),                            # number of authors in set
          n_candidates = ncol(inset))
      }
    }

    ## ---- OPEN SET: outsider novels (true author not a candidate) ----
    for (ostar in corp$id[corp$role == "outsider"]) {
      te <- which(meta$id == ostar)                             # outsider chunks
      if (length(te) == 0) next                                 # too short
      tr <- meta$id != ostar                                    # training rows
      Z <- zfit(tr)                                             # z-scores
      trc <- tr & meta$role == "candidate"                      # all candidate rows
      cb <- calib(Z, trc)                                       # profiles and thresholds
      D <- cosd(Z[te, , drop = FALSE], cb$P)                    # distances to candidates
      for (mth in names(cb$q)) {
        inset <- D <= cb$q[mth]                                 # set membership
        res_open[[length(res_open) + 1]] <- data.frame(
          L = L, method = mth, novel = ostar,
          author = meta$author[te[1]], chunk = seq_along(te),
          empty = rowSums(inset) == 0,                          # correct answer: empty set
          set_size = rowSums(inset))
      }
    }
  }

  closed <- do.call(rbind, res_closed)                          # stack closed-set rows
  openr  <- do.call(rbind, res_open)                            # stack open-set rows

  ## ---- summaries ----
  closed$singleton <- closed$set_size == 1                      # set has exactly one author
  closed$empty     <- closed$set_size == 0                      # known author wrongly rejected
  sum_closed <- aggregate(cbind(covered, set_size, singleton, empty) ~ L + method,
                          data = closed, FUN = mean)            # coverage and set size
  nov_cov <- aggregate(covered ~ L + method + novel, data = closed, FUN = mean)  # coverage per novel
  sum_novel <- aggregate(covered ~ L + method, data = nov_cov,
                         FUN = function(v) mean(v < 1 - ALPHA)) # share of novels under-covered
  names(sum_novel)[3] <- "share_novels_below_target"            # rename
  sum_author <- aggregate(covered ~ L + method + author, data = closed, FUN = mean)  # author-conditional coverage
  openr$false_single <- openr$set_size == 1                     # outsider assigned to one candidate
  sum_open <- aggregate(cbind(empty, false_single, set_size) ~ L + method,
                        data = openr, FUN = mean)               # open-set behaviour

  ## ---- step02 output ----
  wb2 <- createWorkbook()                                       # new workbook
  addWorksheet(wb2, "closed_summary");   writeData(wb2, "closed_summary", sum_closed)     # main table
  addWorksheet(wb2, "closed_by_novel");  writeData(wb2, "closed_by_novel", sum_novel)    # novel-level
  addWorksheet(wb2, "closed_by_author"); writeData(wb2, "closed_by_author", sum_author)  # author-level
  addWorksheet(wb2, "open_summary");     writeData(wb2, "open_summary", sum_open)        # open-set
  addWorksheet(wb2, "closed_chunks");    writeData(wb2, "closed_chunks", closed)         # raw rows
  addWorksheet(wb2, "open_chunks");      writeData(wb2, "open_chunks", openr)            # raw rows
  addWorksheet(wb2, "settings")                                 # run settings
  writeData(wb2, "settings", data.frame(
    item = c("N_MFW", "L_set", "CAP", "ALPHA", "n_candidate_authors", "seed"),
    value = c(N_MFW, paste(L_set, collapse = ","), CAP, ALPHA, length(cand_auth), 2026)))
  saveWorkbook(wb2, file.path(out_dir, "step02_conformal_results.xlsx"), overwrite = TRUE)  # save
  print(sum_closed); print(sum_open)                            # show results in console
} else cat("STEP 02 skipped: step02_conformal_results.xlsx already exists\n")

## =====================================================================
## STEP 03
##  (a) novel-level cluster bootstrap CIs for the step02 results
##  (b) hierarchical conformal variants (Dunn, Wasserman & Ramdas 2023):
##        single_sub : one chunk per novel, conformal quantile (exact >= 1-alpha)
##        cdf_pool   : novel-averaged empirical CDF quantile (asymptotic 1-alpha)
##        rep_sub    : average of B single-subsample p-values (>= 1-2alpha)
##  (c) author-specific (Mondrian) thresholds:
##        mondrian_chunk : per-author quantile of all cross-fit chunks
##        mondrian_book  : per-author quantile, one chunk per novel
##  (d) book effect on top-1 accuracy: chunk-level vs book-level split
## =====================================================================
set.seed(2027)                                                # step03 has its own seed
B_BOOT <- 2000                                                # bootstrap replicates
B_REP  <- 200                                                 # subsamples for rep_sub
N_SPLIT <- 5                                                  # repeats of the chunk-level split

## ---- read step02 chunk-level results (Option A: openxlsx, Option B: readxl) ----
read_sheet <- function(f, s) {
  tryCatch(read.xlsx(f, sheet = s),                           # Option A
    error = function(e) {
      if (!requireNamespace("readxl", quietly = TRUE)) install.packages("readxl")  # install if missing
      as.data.frame(readxl::read_excel(f, sheet = s))         # Option B
    })
}
## ---- (a) cluster bootstrap: resample whole novels, not chunks ----
boot_ci <- function(df, metrics, B = B_BOOT) {
  out <- list()
  for (g in split(df, list(df$L, df$method), drop = TRUE)) {  # each length x method cell
    nov <- unique(g$novel)                                    # novels in this cell
    S <- rowsum(as.matrix(g[, metrics, drop = FALSE]) * 1, g$novel)[nov, , drop = FALSE]  # metric sums per novel
    n <- as.vector(table(g$novel)[nov])                       # chunks per novel
    est <- colSums(S) / sum(n)                                # point estimate (chunk mean)
    bs <- replicate(B, {
      i <- sample.int(length(nov), replace = TRUE)            # draw novels with replacement
      colSums(S[i, , drop = FALSE]) / sum(n[i])               # re-computed means
    })
    bs <- matrix(bs, nrow = length(metrics))                  # metrics x B
    out[[length(out) + 1]] <- data.frame(
      L = g$L[1], method = g$method[1], metric = metrics,
      estimate = est,
      ci_low  = apply(bs, 1, quantile, 0.025),                # 2.5% percentile
      ci_high = apply(bs, 1, quantile, 0.975),                # 97.5% percentile
      n_novels = length(nov), row.names = NULL)
  }
  r <- do.call(rbind, out)                                    # stack cells
  r[order(r$metric, r$method, r$L), ]                         # tidy order
}
## ---- helpers for (b)-(d) ----
build_chunks <- function(L) {                                 # chunk matrix for one length
  ch_list <- lapply(corp$id, function(id) make_chunks(toks[[id]], L, CAP))  # chunks per novel
  n_ch <- lengths(ch_list)                                    # chunks per novel
  meta <- data.frame(id = rep(corp$id, n_ch), author = rep(corp$author, n_ch),
                     role = rep(corp$role, n_ch), stringsAsFactors = FALSE)  # chunk metadata
  X <- do.call(rbind, lapply(unlist(ch_list, recursive = FALSE),
         function(ch) tabulate(match(ch, mfw), nbins = N_MFW) / L))  # relative MFW frequencies
  list(X = X, meta = meta)
}
zfit3 <- function(X, tr) {                                    # z-scores, stats from training rows
  mu <- colMeans(X[tr, , drop = FALSE])                       # feature means
  sdv <- apply(X[tr, , drop = FALSE], 2, sd)                  # feature sds
  sdv[!is.finite(sdv) | sdv == 0] <- 1                        # guard zero sd
  sweep(sweep(X, 2, mu), 2, sdv, "/")                         # z-scores for all rows
}
calib3 <- function(Z, trc, meta) {                            # profiles + cross-fit scores
  S <- rowsum(Z[trc, , drop = FALSE], meta$id[trc])          # z sums per novel
  cnt <- as.vector(table(meta$id[trc])[rownames(S)])          # chunks per novel
  na <- corp$author[match(rownames(S), corp$id)]              # author per novel
  Sa <- rowsum(S, na)                                         # z sums per author
  Na <- tapply(cnt, na, sum)[rownames(Sa)]                    # chunks per author
  P <- Sa / as.vector(Na)                                     # author profiles
  Zt <- Z[trc, , drop = FALSE]                                # candidate training chunks
  idt <- meta$id[trc]                                         # novel of each chunk
  s <- rep(NA_real_, nrow(Zt))                                # cross-fit scores
  for (m in rownames(S)) {                                    # leave one novel out
    a <- na[rownames(S) == m]                                 # its author
    nleft <- Na[a] - cnt[rownames(S) == m]                    # chunks left for the profile
    if (nleft <= 0) next                                      # author has no other novel
    pm <- (Sa[a, ] - S[m, ]) / nleft                          # profile without this novel
    ii <- which(idt == m)                                     # chunks of this novel
    zi <- Zt[ii, , drop = FALSE]                              # their z-scores
    s[ii] <- 1 - (zi %*% pm) / (sqrt(rowSums(zi^2)) * sqrt(sum(pm^2)))  # cosine distance
  }
  ok <- is.finite(s)                                          # usable scores
  list(P = P, s = s[ok], novel = idt[ok], auth = meta$author[trc][ok])
}
qpool <- function(s, g, a) {                                  # novel-averaged CDF quantile (CDF pooling)
  w <- 1 / (length(unique(g)) * as.vector(table(g)[g]))       # each novel gets equal total weight
  o <- order(s)                                               # sort scores
  cw <- cumsum(w[o])                                          # pooled CDF
  s[o][which(cw >= 1 - a - 1e-12)[1]]                         # first score reaching 1-alpha
}
pval_mat <- function(D, s1) {                                 # conformal p-values of test distances
  s1 <- sort(s1); k <- length(s1)                             # calibration scores
  ge <- k - findInterval(D, s1, left.open = TRUE)             # number of scores >= D
  matrix((1 + ge) / (k + 1), nrow = nrow(D), dimnames = dimnames(D))  # p-value matrix
}
pick_one <- function(g) {                                     # index of one random chunk per novel
  unlist(tapply(seq_along(g), g, function(v) v[sample.int(length(v), 1)]), use.names = FALSE)
}
top1 <- function(D) colnames(D)[max.col(-D, ties.method = "first")]  # nearest author

## ---- step03 runs only if its output does not exist yet (already done -> skipped) ----
f03 <- file.path(out_dir, "step03_results.xlsx")             # step03 output file
if (!file.exists(f03)) {
  cl02 <- read_sheet(f02, "closed_chunks")                      # closed-set rows from step02
  op02 <- read_sheet(f02, "open_chunks")                        # open-set rows from step02
  for (v in c("covered", "empty", "false_single")) {            # make 0/1 columns numeric
    if (v %in% names(cl02)) cl02[[v]] <- as.numeric(as.logical(cl02[[v]]))
    if (v %in% names(op02)) op02[[v]] <- as.numeric(as.logical(op02[[v]]))
  }
  cl02$singleton <- as.numeric(cl02$set_size == 1)              # one-author set
  cl02$empty     <- as.numeric(cl02$set_size == 0)              # empty set
  op02$false_single <- as.numeric(op02$set_size == 1)           # outsider given one author
  op02$empty        <- as.numeric(op02$set_size == 0)           # outsider correctly rejected

  boot02_closed <- boot_ci(cl02, c("covered", "set_size", "singleton", "empty"))  # step02 closed set
  boot02_open   <- boot_ci(op02, c("empty", "false_single", "set_size"))          # step02 open set

  ## ---- (b)-(d) main loop ----
  res3 <- list(); acc3 <- list()                                # result containers
  for (L in L_set) {
    cat("STEP 03, chunk length L =", L, "\n")                   # progress
    bc <- build_chunks(L); X <- bc$X; meta <- bc$meta           # chunks for this length

    ## ---- closed set, leave one candidate novel out ----
    for (nstar in corp$id[corp$role == "candidate"]) {
      te <- which(meta$id == nstar)                             # test chunks
      if (length(te) == 0) next                                 # novel shorter than L
      tr <- meta$id != nstar                                    # training rows
      Z <- zfit3(X, tr)                                         # z-scores
      trc <- tr & meta$role == "candidate"                      # candidate training rows
      cb <- calib3(Z, trc, meta)                                # profiles and scores
      true_a <- meta$author[te[1]]                              # true author
      if (!(true_a %in% rownames(cb$P))) next                   # author has no other novel
      D <- cosd(Z[te, , drop = FALSE], cb$P)                    # test distances

      psum <- 0                                                 # running sum of p-values
      for (b in seq_len(B_REP)) {                               # repeated subsampling
        one <- pick_one(cb$novel)                               # one chunk per novel
        psum <- psum + pval_mat(D, cb$s[one])                   # add this subsample's p-values
      }
      pbar <- psum / B_REP                                      # averaged p-values
      one <- pick_one(cb$novel)                                 # fresh single subsample
      q_single <- qconf(cb$s[one], ALPHA)                       # single subsampling threshold
      q_pool <- qpool(cb$s, cb$novel, ALPHA)                    # CDF pooling threshold
      q_mch <- tapply(cb$s, cb$auth, qconf, a = ALPHA)[colnames(D)]  # per-author, all chunks
      q_mch[is.na(q_mch)] <- Inf                                # no scores -> include author
      q_mbk <- sapply(colnames(D), function(a)
        qconf(cb$s[one][cb$auth[one] == a], ALPHA))             # per-author, one chunk per novel

      sets <- list(single_sub     = D <= q_single,              # Dunn et al. method 2
                   cdf_pool       = D <= q_pool,                # Dunn et al. method 1
                   rep_sub        = pbar >= ALPHA,              # Dunn et al. method 3
                   mondrian_chunk = sweep(D, 2, q_mch, "<="),   # author-specific, chunk level
                   mondrian_book  = sweep(D, 2, q_mbk, "<="))   # author-specific, novel level
      pred <- top1(D)                                           # nearest author per chunk
      for (mth in names(sets)) {
        inset <- sets[[mth]]                                    # prediction sets
        res3[[length(res3) + 1]] <- data.frame(
          L = L, method = mth, novel = nstar, author = true_a,
          covered = as.numeric(inset[, true_a]),                # true author in set
          set_size = rowSums(inset),                            # authors in set
          singleton = as.numeric(rowSums(inset) == 1),          # exactly one author
          empty = as.numeric(rowSums(inset) == 0),              # no author
          top1 = as.numeric(pred == true_a))                    # nearest author correct
      }
    }

    ## ---- (d) chunk-level split: half of each candidate novel's chunks in training ----
    cand_rows <- which(meta$role == "candidate")                # candidate chunks
    for (r in seq_len(N_SPLIT)) {
      te <- unlist(tapply(cand_rows, meta$id[cand_rows], function(v)
        v[sample.int(length(v), floor(length(v) / 2))]), use.names = FALSE)  # half of each novel to test
      tr <- !(seq_len(nrow(meta)) %in% te)                      # everything else trains
      Z <- zfit3(X, tr)                                         # z-scores
      trc <- tr & meta$role == "candidate"                      # candidate training rows
      S <- rowsum(Z[trc, , drop = FALSE], meta$author[trc])     # z sums per author
      P <- S / as.vector(table(meta$author[trc])[rownames(S)])  # profiles incl. same novel
      D <- cosd(Z[te, , drop = FALSE], P)                       # test distances
      acc3[[length(acc3) + 1]] <- data.frame(L = L, split = "chunk_level", rep = r,
        accuracy = mean(top1(D) == meta$author[te]))            # top-1 accuracy
    }
  }
  cl03 <- do.call(rbind, res3)                                  # stack step03 closed-set rows
  acc3 <- do.call(rbind, acc3)                                  # stack chunk-split accuracy

  ## ---- summaries ----
  boot03_closed <- boot_ci(cl03, c("covered", "set_size", "singleton", "empty"))  # new methods with CIs
  by_author03 <- aggregate(covered ~ L + method + author, data = cl03, FUN = mean)  # author coverage
  book_acc <- boot_ci(cl03[cl03$method == "single_sub", ], "top1")  # book-level top-1 accuracy + CI
  chunk_acc <- aggregate(accuracy ~ L, data = acc3,
                         FUN = function(v) c(mean = mean(v), min = min(v), max = max(v)))  # over repeats
  chunk_acc <- data.frame(L = chunk_acc$L, chunk_acc$accuracy)  # flatten matrix column
  acc_tab <- data.frame(L = book_acc$L,
                        acc_book_level = book_acc$estimate,     # held-out novel
                        acc_book_ci_low = book_acc$ci_low,
                        acc_book_ci_high = book_acc$ci_high,
                        acc_chunk_level = chunk_acc$mean[match(book_acc$L, chunk_acc$L)],  # same novel in training
                        acc_chunk_min = chunk_acc$min[match(book_acc$L, chunk_acc$L)],
                        acc_chunk_max = chunk_acc$max[match(book_acc$L, chunk_acc$L)])
  acc_tab$drop <- acc_tab$acc_chunk_level - acc_tab$acc_book_level  # book effect on accuracy

  ## ---- step03 output ----
  wb3 <- createWorkbook()                                       # new workbook
  addWorksheet(wb3, "step02_boot_closed"); writeData(wb3, "step02_boot_closed", boot02_closed)  # (a)
  addWorksheet(wb3, "step02_boot_open");   writeData(wb3, "step02_boot_open", boot02_open)      # (a)
  addWorksheet(wb3, "step03_boot_closed"); writeData(wb3, "step03_boot_closed", boot03_closed)  # (b)(c)
  addWorksheet(wb3, "step03_by_author");   writeData(wb3, "step03_by_author", by_author03)      # (c)
  addWorksheet(wb3, "accuracy_book_effect"); writeData(wb3, "accuracy_book_effect", acc_tab)    # (d)
  addWorksheet(wb3, "settings")                                 # run settings
  writeData(wb3, "settings", data.frame(
    item = c("B_BOOT", "B_REP", "N_SPLIT", "ALPHA", "seed_step03"),
    value = c(B_BOOT, B_REP, N_SPLIT, ALPHA, 2027)))
  saveWorkbook(wb3, file.path(out_dir, "step03_results.xlsx"), overwrite = TRUE)  # save
  print(boot03_closed[boot03_closed$metric == "covered", ])     # coverage in console
  print(acc_tab)                                                # accuracy in console
} else cat("STEP 03 skipped: step03_results.xlsx already exists\n")

