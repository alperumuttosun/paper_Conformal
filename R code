             Boisgobey = "Boisgobey, Fortun\u00e9 du", Ohnet = "Ohnet, Georges", Maupassant = "Maupassant, Guy de",
             Feval = "F\u00e9val, Paul", Dombre = "Dombre, Roger", Verne = "Verne, Jules", Aimard = "Aimard, Gustave",
