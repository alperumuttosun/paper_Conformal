## ---- (a) download and parse one language (skipped if its cache exists) ----
get_corpus <- function(lang) {
  csv <- file.path(out_dir, sprintf("step04_eltec_%s_texts.csv", lang))  # cache file
  if (!file.exists(csv)) {
    pref <- toupper(lang)                                     # file prefix: FRA / DEU
    tmp <- file.path(tempdir(), paste0("eltec_", lang))       # temp folder (auto-cleaned by R)
    dir.create(tmp, showWarnings = FALSE)                     # make temp folder
    xml_files <- character(0)                                 # TEI file list

    ## ---- Option A: whole repository as zip ----
    for (br in c("master", "main")) {                         # try both branch names
      zurl <- sprintf("https://github.com/COST-ELTeC/ELTeC-%s/archive/refs/heads/%s.zip", lang, br)
      zf <- file.path(tmp, paste0(lang, ".zip"))              # local zip path
      r <- try(download.file(zurl, zf, mode = "wb", quiet = TRUE), silent = TRUE)  # download
      if (!inherits(r, "try-error") && file.exists(zf) && file.size(zf) > 1e6) {
        unzip(zf, exdir = tmp)                                # extract
        f_all <- list.files(tmp, pattern = sprintf("^%s.*\\.xml$", pref),
                            recursive = TRUE, full.names = TRUE)  # all TEI files
        f_l1 <- f_all[grepl("level1", f_all)]                 # keep level-1 encoding
        xml_files <- if (length(f_l1) > 0) f_l1 else f_all    # fall back to any level
        xml_files <- xml_files[!duplicated(basename(xml_files))]  # one file per novel
        if (length(xml_files) > 0) break                      # done
      }
    }
    ## ---- Option B: GitHub API listing, one file at a time ----
    if (length(xml_files) == 0) {
      lst <- fromJSON(sprintf("https://api.github.com/repos/COST-ELTeC/ELTeC-%s/contents/level1", lang))
      lst <- lst[grepl("\\.xml$", lst$name), ]                # XML only
      for (i in seq_len(nrow(lst))) {
        dest <- file.path(tmp, lst$name[i])                   # local path
        try(download.file(lst$download_url[i], dest, mode = "wb", quiet = TRUE), silent = TRUE)
      }
      xml_files <- list.files(tmp, pattern = sprintf("^%s.*\\.xml$", pref), full.names = TRUE)
    }
    cat(lang, "TEI files found:", length(xml_files), "\n")    # report

    parse_l <- function(f) {
      doc <- read_xml(f); xml_ns_strip(doc)                   # read XML, drop namespaces
      id <- sub("\\.xml$", "", basename(f))                   # novel id
      au <- xml_text(xml_find_first(doc, "//teiHeader//titleStmt/author"))  # header author
      au <- trimws(gsub("\\s+", " ", sub("\\(.*$", "", au)))  # drop dates, tidy spaces
      if (grepl("_", id)) au <- sub("^[^_]+_", "", id)        # FRA files: author key from file name
      data.frame(id = id, author = au,
                 title = trimws(xml_text(xml_find_first(doc, "//teiHeader//titleStmt/title"))),
                 text = xml_text(xml_find_first(doc, "//text/body")),  # novel body
                 stringsAsFactors = FALSE)
    }
    cl <- do.call(rbind, lapply(xml_files, parse_l))          # parse all novels
    write.csv(cl, csv, row.names = FALSE, fileEncoding = "UTF-8")  # cache
  }
  cl <- tryCatch(read.csv(csv, stringsAsFactors = FALSE, encoding = "UTF-8"),       # Option A
                 error = function(e) read.csv(csv, stringsAsFactors = FALSE, fileEncoding = "UTF-8"))  # Option B
  for (v in c("author", "title", "text")) cl[[v]] <- fix_utf8(cl[[v]])  # repair encoding
  cl
}

## ---- tokenizer for French/German: apostrophes split words (l'homme -> l homme) ----
tok_l <- function(x) {
  w <- tryCatch(gsub("[^\\p{L}]+", " ", tolower(x), perl = TRUE),  # Option A: Unicode letters
    error = function(e) {
      y <- iconv(x, from = "UTF-8", to = "ASCII//TRANSLIT", sub = " ")  # Option B: ASCII
      gsub("[^a-z]+", " ", tolower(y))
    })
  w <- strsplit(w, "\\s+")[[1]]                               # split on spaces
  w[nchar(w) > 0]                                             # drop empty tokens
}

## ---- helpers that take the language corpus as input ----
build_chunks4 <- function(cl, tk, mf, L) {                    # chunk matrix for one language
  ch_list <- lapply(cl$id, function(id) make_chunks(tk[[id]], L, CAP))  # chunks per novel
  n_ch <- lengths(ch_list)                                    # chunks per novel
  meta <- data.frame(id = rep(cl$id, n_ch), author = rep(cl$author, n_ch),
                     role = rep(cl$role, n_ch), stringsAsFactors = FALSE)  # metadata
  X <- do.call(rbind, lapply(unlist(ch_list, recursive = FALSE),
         function(ch) tabulate(match(ch, mf), nbins = length(mf)) / L))  # MFW frequencies
  list(X = X, meta = meta)
}
calib4 <- function(Z, trc, meta) {                            # profiles, naive + cross-fit scores
  S <- rowsum(Z[trc, , drop = FALSE], meta$id[trc])          # z sums per novel
  cnt <- as.vector(table(meta$id[trc])[rownames(S)])          # chunks per novel
  na <- meta$author[trc][match(rownames(S), meta$id[trc])]    # author per novel
  Sa <- rowsum(S, na)                                         # z sums per author
  Na <- tapply(cnt, na, sum)[rownames(Sa)]                    # chunks per author
  P <- Sa / as.vector(Na)                                     # author profiles
  Zt <- Z[trc, , drop = FALSE]                                # candidate training chunks
  idt <- meta$id[trc]; aut <- meta$author[trc]                # novel and author per chunk
  s_naive <- cosd(Zt, P)[cbind(seq_len(nrow(Zt)), match(aut, rownames(P)))]  # own novel inside profile
  s <- rep(NA_real_, nrow(Zt))                                # cross-fit scores
  for (m in rownames(S)) {                                    # leave one novel out
    a <- na[rownames(S) == m]                                 # its author
    nleft <- Na[a] - cnt[rownames(S) == m]                    # chunks left
    if (nleft <= 0) next                                      # no other novel
    pm <- (Sa[a, ] - S[m, ]) / nleft                          # profile without this novel
    ii <- which(idt == m); zi <- Zt[ii, , drop = FALSE]       # chunks of this novel
    s[ii] <- 1 - (zi %*% pm) / (sqrt(rowSums(zi^2)) * sqrt(sum(pm^2)))  # cosine distance
  }
  ok <- is.finite(s)                                          # usable cross-fit scores
  list(P = P, s_naive = s_naive, s = s[ok], novel = idt[ok], auth = aut[ok])
}

## ---- (b) one language: closed set, open set, accuracy; (c) heterogeneity ----
run_lang <- function(lang, cl, tk) {
  an <- table(cl$author)                                      # novels per author
  cl$role <- ifelse(cl$author %in% names(an)[an >= 2], "candidate", "outsider")  # same rule as English
  mf <- names(sort(table(unlist(tk[cl$role == "candidate"], use.names = FALSE)),
                   decreasing = TRUE))[1:N_MFW]               # language-specific MFW
  rc <- list(); ro <- list(); ra <- list(); het <- NULL       # containers
  for (L in L_set) {
    cat(lang, "L =", L, "\n")                                 # progress
    bc <- build_chunks4(cl, tk, mf, L); X <- bc$X; meta <- bc$meta

    ## closed set: leave one candidate novel out
    for (nstar in cl$id[cl$role == "candidate"]) {
      te <- which(meta$id == nstar); if (length(te) == 0) next  # test chunks
      tr <- meta$id != nstar; Z <- zfit3(X, tr)               # z-scores from training rows
      trc <- tr & meta$role == "candidate"                    # candidate training rows
      cb <- calib4(Z, trc, meta); ta <- meta$author[te[1]]    # calibration, true author
      if (!(ta %in% rownames(cb$P))) next                     # author has no other novel
      D <- cosd(Z[te, , drop = FALSE], cb$P)                  # test distances
      psum <- 0
      for (b in seq_len(B_REP4)) psum <- psum + pval_mat(D, cb$s[pick_one(cb$novel)])  # repeated subsampling
      one <- pick_one(cb$novel)                               # single subsample
      sets <- list(naive      = D <= qconf(cb$s_naive, ALPHA),
                   single_sub = D <= qconf(cb$s[one], ALPHA),
                   cdf_pool   = D <= qpool(cb$s, cb$novel, ALPHA),
                   rep_sub    = (psum / B_REP4) >= ALPHA)
      pred <- top1(D)                                         # nearest author
      for (mth in names(sets)) {
        ins <- sets[[mth]]
        rc[[length(rc) + 1]] <- data.frame(lang = lang, L = L, method = mth, novel = nstar, author = ta,
          covered = as.numeric(ins[, ta]), set_size = rowSums(ins),
          singleton = as.numeric(rowSums(ins) == 1), empty = as.numeric(rowSums(ins) == 0),
          top1 = as.numeric(pred == ta))
      }
    }

    ## open set: outsider novels
    for (ostar in cl$id[cl$role == "outsider"]) {
      te <- which(meta$id == ostar); if (length(te) == 0) next
      tr <- meta$id != ostar; Z <- zfit3(X, tr)
      trc <- tr & meta$role == "candidate"
      cb <- calib4(Z, trc, meta)
      D <- cosd(Z[te, , drop = FALSE], cb$P)
      one <- pick_one(cb$novel)
      sets <- list(naive = D <= qconf(cb$s_naive, ALPHA), single_sub = D <= qconf(cb$s[one], ALPHA))
      for (mth in names(sets)) {
        k <- rowSums(sets[[mth]])                             # set size
        ro[[length(ro) + 1]] <- data.frame(lang = lang, L = L, method = mth, novel = ostar,
          empty = as.numeric(k == 0), false_single = as.numeric(k == 1), set_size = k)
      }
    }

    ## accuracy with chunk-level split (same novel in training)
    cr <- which(meta$role == "candidate")
    for (r in seq_len(N_SPLIT4)) {
      te <- unlist(tapply(cr, meta$id[cr], function(v) v[sample.int(length(v), floor(length(v) / 2))]),
                   use.names = FALSE)                         # half of each novel to test
      tr <- !(seq_len(nrow(meta)) %in% te); Z <- zfit3(X, tr)
      trc <- tr & meta$role == "candidate"
      S <- rowsum(Z[trc, , drop = FALSE], meta$author[trc])
      P <- S / as.vector(table(meta$author[trc])[rownames(S)])  # profiles incl. same novel
      ra[[length(ra) + 1]] <- data.frame(lang = lang, L = L, rep = r,
        accuracy = mean(top1(cosd(Z[te, , drop = FALSE], P)) == meta$author[te]))
    }

    ## (c) between-book heterogeneity at one chunk length
    if (L == L_HET) {
      cand <- meta$role == "candidate"
      Za <- zfit3(X, cand)                                    # z-scores from candidate chunks
      NP <- rowsum(Za[cand, , drop = FALSE], meta$id[cand])   # novel profile sums
      NP <- NP / as.vector(table(meta$id[cand])[rownames(NP)])  # novel mean profiles
      Dn <- cosd(NP, NP)                                      # novel x novel distance
      na <- cl$author[match(rownames(NP), cl$id)]             # author of each novel
      het <- do.call(rbind, lapply(unique(na), function(a) {
        w <- which(na == a); o <- which(na != a)              # own and other novels
        within <- mean(Dn[w, w][upper.tri(Dn[w, w])])         # mean distance among own novels
        between <- median(Dn[w, o])                           # typical distance to other authors
        data.frame(lang = lang, author = a, n_novels = length(w),
                   within = within, between = between, ratio = within / between)
      }))
    }
  }
  list(closed = do.call(rbind, rc), open = do.call(rbind, ro), acc = do.call(rbind, ra), het = het,
       info = data.frame(lang = lang, n_novels = nrow(cl), n_candidate_authors = sum(an >= 2),
                         n_candidate_novels = sum(cl$role == "candidate"),
                         n_outsider_novels = sum(cl$role == "outsider")))
}

