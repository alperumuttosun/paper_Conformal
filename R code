for (p in c("ggplot2")) if (!requireNamespace(p, quietly = TRUE)) install.packages(p)  # install if missing
library(ggplot2)                                              # plotting
has_repel <- requireNamespace("ggrepel", quietly = TRUE)      # optional label repelling
fig_dir <- file.path(out_dir, "figures")                      # figure folder
if (!dir.exists(fig_dir)) dir.create(fig_dir)                 # create once
