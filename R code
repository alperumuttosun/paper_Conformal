## Output: manuscript_tables.xlsx
## =====================================================================
f09 <- file.path(out_dir, "manuscript_tables.xlsx")           # step09 output file
f08 <- file.path(out_dir, "step08_mondrian.xlsx")             # step08 output (defined again for clarity)
if (!file.exists(f09)) {
  ## ---- helpers ----
  rh <- function(x, d = 2) sign(x) * floor(abs(x) * 10^d + 0.5 + 1e-9) / 10^d       # round half up
  fx <- function(x, d = 2) ifelse(is.na(x), "", sprintf(paste0("%.", d, "f"), rh(x, d)))  # fixed decimals
  fci <- function(e, l, h, d = 2) paste0(fx(e, d), " [", fx(l, d), ", ", fx(h, d), "]")  # estimate [CI]
  LANGN <- c(eng = "English", fra = "French", deu = "German")
