  mcx <- mc[!(mc$lang == "fra" & mc$L == 5000), ]
  addn("3.1", "MFW: max |coverage change| outside French 5,000 (points)", fx(max(abs(mcx$diff_points)), 2))
  fw <- mwd[mwd$word == "fortune", ]
  addn("3.1", "F\u00e9val: 'fortune' in all French candidate novels / in this novel", paste(fw$count_all_candidates, fw$count_this_novel, sep = " / "))
  fv <- mnd[mnd$L == 5000, ]
  addn("3.1", "F\u00e9val 5,000 words: chunks covered (CDF pooling), global / fold / total", paste(fv$covered_global, fv$covered_fold, fv$n_chunks, sep = " / "))
  for (lg in c("eng", "fra", "deu")) {
    d <- merge(sel9(cv, lang = lg, method = "single_sub")[, c("L", "estimate")], sel9(cv, lang = lg, method = "naive")[, c("L", "estimate")], by = "L")
    a <- sel9(am, lang = lg)
    addn("3.3", paste("coverage gap range (points)", lg), paste0(fx(100 * min(d$estimate.x - d$estimate.y), 0), "\u2013", fx(100 * max(d$estimate.x - d$estimate.y), 0)))
    addn("3.3", paste("accuracy gap range (points)", lg), paste0(fx(100 * min(a$drop), 0), "\u2013", fx(100 * max(a$drop), 0))) }
  gp <- merge(sel9(cv, method = "single_sub")[, c("lang", "L", "estimate")], sel9(cv, method = "naive")[, c("lang", "L", "estimate")], by = c("lang", "L"))
  gp <- merge(gp, am[, c("lang", "L", "drop")], by = c("lang", "L"))
  addn("3.3", "settings where coverage gap > accuracy gap", paste(sum(gp$estimate.x - gp$estimate.y > gp$drop), "of", nrow(gp)))
  addn("3.3", "max SD between chunk splits (points)", fx(100 * max(am$acc_chunk_sd), 1))
  addn("3.3", "min (2.5th percentile of splits - upper CI of held-out accuracy), points", fx(100 * min(am$acc_chunk_q025 - am$acc_book_ci_high), 1))
  addn("3.4", "authors below 0.85 (single subsampling)", sum(hm$covered < 0.85))
  for (lg in c("pooled", "eng", "fra", "deu")) addn("3.4", paste("Spearman rho, L = 2,000,", lg), fx(sel9(hc, lang = lg)$spearman_rho))
  for (lg in c("pooled", "eng", "fra", "deu")) { d <- sel9(hcl, lang = lg)
    addn("3.4", paste("Spearman rho over lengths,", lg), paste0(fx(min(d$rho_pooled_cov)), " to ", fx(max(d$rho_pooled_cov)))) }
  for (lg in c("fra", "deu")) { d <- sel9(ntc, lang = lg, method = "single_sub", ntype = "2 novels")
    addn("3.4", paste("two-novel authors, single subsampling coverage range", lg), paste0(fx(min(d$estimate)), "\u2013", fx(max(d$estimate))))
    addn("3.4", paste("two-novel authors, CIs including 0.90", lg), paste(sum(d$ci_low <= 0.9 & d$ci_high >= 0.9), "of", nrow(d))) }
  d3 <- sel9(ntc, method = "single_sub", ntype = "3+ novels")
  addn("3.4", "three-novel+ authors, single subsampling coverage range", paste0(fx(min(d3$estimate)), "\u2013", fx(max(d3$estimate))))
  m3 <- mba[mba$n_novels >= 3, ]
  addn("3.4", "Mondrian: authors with 3+ novels", nrow(m3))
  addn("3.4", "Mondrian (all chunks): 3+ authors below 0.85 / single subsampling", paste(sum(m3$cov.mondrian_chunk < 0.85), "/", sum(m3$cov.single_sub < 0.85)))
  addn("3.4", "Mondrian (all chunks): coverage range, 3+ authors", paste0(fx(min(m3$cov.mondrian_chunk)), "\u2013", fx(max(m3$cov.mondrian_chunk))))
  addn("3.4", "Mondrian (all chunks): two-novel authors with coverage 1", paste(sum(mba$n_novels == 2 & mba$cov.mondrian_chunk == 1), "of", sum(mba$n_novels == 2)))
  for (lg in c("eng", "fra", "deu")) { d <- sel9(mcl, lang = lg, method = "mondrian_chunk", metric = "covered")
    addn("3.4", paste("Mondrian (all chunks): overall coverage range", lg), paste0(fx(min(d$estimate)), "\u2013", fx(max(d$estimate))))
    d <- sel9(mcl, lang = lg, method = "mondrian_book", metric = "set_size")
    addn("3.4", paste("Mondrian (one chunk per novel): mean set size range", lg), paste0(fx(min(d$estimate), 1), "\u2013", fx(max(d$estimate), 1))) }
  for (lg in c("eng", "fra", "deu")) { d <- sel9(cp, lang = lg)
    addn("2.4", paste("calibration pool size per round", lg), paste0(min(d$cal_min), "\u2013", max(d$cal_max))) }
  ## Discussion: seeds and the Vischer/Ruppius check
  for (m in c("cdf_pool", "single_sub", "naive")) addn("4", paste("seeds: max coverage range (points),", m), fx(max(sr$cov_range_points[sr$method == m]), 1))
  addn("4", "seeds: book-level coverage over all runs", paste0(fx(min(sr$cov_min[sr$method != "naive"])), "\u2013", fx(max(sr$cov_max[sr$method != "naive"]))))
  addn("4", "seeds: within-novel coverage over all runs", paste0(fx(min(sr$cov_min[sr$method == "naive"])), "\u2013", fx(max(sr$cov_max[sr$method == "naive"]))))
  addn("4", "mean coverage, CDF pooling / single subsampling", paste(fx(mean(bl$estimate[bl$method == "cdf_pool"])), fx(mean(bl$estimate[bl$method == "single_sub"])), sep = " / "))
  de <- nl6[nl6$variant == "fold" & nl6$lang == "deu", ]
  exc <- grepl("Vischer|Ruppius", de$author)                  # two volumes of one work; novel + sequel
  cov_by <- function(d) { a <- aggregate(cbind(covered, n_chunks) ~ L + method, data = d, FUN = sum); a$c <- a$covered / a$n_chunks; a }
  dd <- merge(cov_by(de), cov_by(de[!exc, ]), by = c("L", "method"))
  addn("4", "German: max |coverage change| without Vischer and Ruppius (points)", fx(100 * max(abs(dd$c.y - dd$c.x)), 2))
  sp9 <- function(d) unname(suppressWarnings(cor.test(d$ratio, d$covered, method = "spearman"))$estimate)
  hd <- hm[hm$lang == "deu", ]; hx <- !grepl("Vischer|Ruppius", hm$author)
  addn("4", "German rho with / without Vischer and Ruppius", paste(fx(sp9(hd)), fx(sp9(hd[!grepl("Vischer|Ruppius", hd$author), ])), sep = " / "))
  addn("4", "All-author rho with / without Vischer and Ruppius", paste(fx(sp9(hm)), fx(sp9(hm[hx, ])), sep = " / "))
  numbers <- do.call(rbind, num)

  ## ---- output (Option A xlsx, Option B csv) ----
  save6(list(T2 = T2, S1 = S1, S2 = S2, S3 = S3, S4 = S4, S5A = S5A, S5B = S5B, S6 = S6, S7 = S7,
             S8 = S8, S9 = S9, text_numbers = numbers), f09, prefix = "manuscript_tables_")
  for (i in seq_len(nrow(numbers))) cat(sprintf("%-4s %-75s %s\n", numbers$item[i], numbers$statistic[i], numbers$value[i]))
} else cat("STEP 09 skipped: manuscript_tables.xlsx already exists\n")

## =====================================================================
## STEP 10 - Are calibration and test scores comparable? (+ three small checks)
##  (a) calibration pool without the test author's other novels  -> equal profile size
##  (b) nested scores: for every calibration novel, MFW and z-scaling re-estimated without it
##      -> each calibration score is produced exactly like the test score
##  (c) a and b together
##  (d) whole-novel holdout with half of every training novel's chunks (training size check)
##  (e) repeated subsampling with 500 instead of 100 subsamples
##  (f) dispersion checks: within-language ranks, authors with 3+ novels, alternative ratio
##  (g) novels other than Feval affected by the MFW choice; R version and packages
## Same design as step06/07 (fold-wise MFW). Output: step10_results.xlsx
## =====================================================================
f10 <- file.path(out_dir, "step10_results.xlsx")             # step10 output file
if (!file.exists(f10)) {
  t10 <- Sys.time(); rows10 <- list(); het10 <- list()
  for (lang in LANGS) {
    set.seed(2034)                                            # step10 seed (per language)
    lc <- lang_corpus6(lang); vc <- voc6(lc$cl, lc$tk)        # cached corpus, no download
    for (L in L_set) {
      cat("STEP 10", lang, "L =", L, "|", format(round(difftime(Sys.time(), t10, units = "mins"), 1)), "\n")
      bc <- chunks6(lc$cl, lc$tk, vc$V, L); meta <- bc$meta
      for (nstar in rownames(vc$NV)) {                        # every candidate novel held out once
        te <- which(meta$id == nstar); if (length(te) == 0) next
        tr <- meta$id != nstar; trc <- tr & meta$role == "candidate"
        ta <- meta$author[te[1]]                              # true author
        Z <- zfit3(bc$CV[, mfw_idx6(vc$NV, nstar, "fold"), drop = FALSE], tr)  # main design
        cb <- calib4(Z, trc, meta)
        if (!(ta %in% rownames(cb$P))) next
        D <- cosd(Z[te, , drop = FALSE], cb$P)                # test distances (main design)
        ## (b) nested calibration scores: MFW list and z-scaling also without the calibration novel
        s_nest <- rep(NA_real_, length(cb$s))
        for (m in unique(cb$novel)) {
          w <- which(cb$novel == m); am <- cb$auth[w[1]]
          keep <- !(rownames(vc$NV) %in% c(nstar, m))
          idm <- order(-colSums(vc$NV[keep, , drop = FALSE]))[1:N_MFW]       # MFW without nstar and m
          trm <- tr & meta$id != m
          Zm <- zfit3(bc$CV[, idm, drop = FALSE], trm)                       # z-scaling without m
          oth <- trc & meta$author == am & meta$id != m                       # author's other novels
          pm <- matrix(colMeans(Zm[oth, , drop = FALSE]), nrow = 1)         # profile without m
          s_nest[w] <- cosd(Zm[meta$id == m, , drop = FALSE], pm)[, 1]      # same row order as cb$s
        }
        ## calibration pools for the four designs
        same <- cb$auth == ta                                 # novels of the test author
        pools <- list(main = list(s = cb$s, g = cb$novel),
                      excl_author = list(s = cb$s[!same], g = cb$novel[!same]),
                      nested = list(s = s_nest, g = cb$novel),
                      nested_excl_author = list(s = s_nest[!same], g = cb$novel[!same]))
        sets <- list()
        for (v in names(pools)) {
          p <- pools[[v]]
          sets[[paste(v, "single_sub", sep = "|")]] <- D <= qconf(p$s[pick_one(p$g)], ALPHA)
          sets[[paste(v, "cdf_pool", sep = "|")]]   <- D <= qpool(p$s, p$g, ALPHA)
        }
        ## (e) repeated subsampling with 100 and 500 subsamples (main design)
        ps <- 0
        for (b in seq_len(500)) {
          ps <- ps + pval_mat(D, cb$s[pick_one(cb$novel)])
          if (b == 100) sets[["main|rep_sub_100"]] <- (ps / 100) >= ALPHA
        }
        sets[["main|rep_sub_500"]] <- (ps / 500) >= ALPHA
        ## (d) whole-novel holdout with half of every training novel's chunks
        rc <- which(trc)
        half <- unlist(tapply(rc, meta$id[rc], function(v) v[sample.int(length(v), max(1, floor(length(v) / 2)))]),
                       use.names = FALSE)
        Ph <- rowsum(Z[half, , drop = FALSE], meta$author[half])
        Ph <- Ph / as.vector(table(meta$author[half])[rownames(Ph)])
        hit_full <- sum(top1(D) == ta)
        hit_half <- sum(top1(cosd(Z[te, , drop = FALSE], Ph)) == ta)
        for (k in names(sets)) {
          kk <- strsplit(k, "|", fixed = TRUE)[[1]]; ns <- rowSums(sets[[k]])
          rows10[[length(rows10) + 1]] <- data.frame(
            lang = lang, L = L, design = kk[1], method = kk[2], novel = nstar, author = ta,
            n_auth = meta$n_auth[te[1]], n_chunks = length(te),
            covered = sum(sets[[k]][, ta]), set_size = sum(ns), singleton = sum(ns == 1),
            empty = sum(ns == 0), top1 = hit_full, top1_half = hit_half, stringsAsFactors = FALSE)
        }
      }
      ## (f) alternative dispersion ratio at the heterogeneity length
      if (L == L_HET) {
        cand <- meta$role == "candidate"
        Za <- zfit3(bc$CV[, seq_len(N_MFW)], cand)
        NP <- rowsum(Za[cand, , drop = FALSE], meta$id[cand]); NP <- NP / as.vector(table(meta$id[cand])[rownames(NP)])
        Dn <- cosd(NP, NP); na <- lc$cl$author[match(rownames(NP), lc$cl$id)]
        for (a in unique(na)) {
          wi <- which(na == a)
          within <- mean(Dn[wi, wi][upper.tri(Dn[wi, wi])])
          nearest <- min(sapply(setdiff(unique(na), a), function(b) mean(Dn[wi, na == b])))  # closest other author
          het10[[length(het10) + 1]] <- data.frame(lang = lang, author = a, n_novels = length(wi),
                                                   within = within, nearest_other = nearest,
                                                   ratio_alt = within / nearest)
        }
      }
    }
    rm(lc, vc, bc); invisible(gc())
  }
  nl10 <- do.call(rbind, rows10); h10 <- do.call(rbind, het10)
  tryCatch(write.csv(nl10, file.path(out_dir, "step10_novel_level_backup.csv"), row.names = FALSE),
           error = function(e) NULL)                          # safety copy of the long analysis
  cat("Analyses done, summaries start |", format(round(difftime(Sys.time(), t10, units = "mins"), 1)), "\n")

  ## ---- (a)-(c), (e): coverage, set size, single-author share (chunk weight, novel bootstrap) ----
  set.seed(2035)
  cells10 <- split(nl10, list(nl10$lang, nl10$L, nl10$design, nl10$method), drop = TRUE)
  comp <- do.call(rbind, lapply(cells10, function(g)
    cbind(g[1, c("lang", "L", "design", "method")],
          boot_w6(g, c("covered", "set_size", "singleton", "empty"), "novel")[1:4, ], row.names = NULL)))
  rownames(comp) <- NULL
  cw <- comp[comp$metric == "covered" & comp$method %in% c("single_sub", "cdf_pool"), ]
  comp_diff <- merge(cw[cw$design != "main", c("lang", "L", "design", "method", "estimate", "ci_low", "ci_high")],
                     cw[cw$design == "main", c("lang", "L", "method", "estimate")],
                     by = c("lang", "L", "method"), suffixes = c("", "_main"))
  comp_diff$diff_points <- 100 * (comp_diff$estimate - comp_diff$estimate_main)
  comp_summary <- do.call(rbind, lapply(split(comp_diff, list(comp_diff$design, comp_diff$method), drop = TRUE), function(d)
    data.frame(design = d$design[1], method = d$method[1], cov_min = min(d$estimate), cov_max = max(d$estimate),
               diff_min_points = min(d$diff_points), diff_max_points = max(d$diff_points),
               ci_upper_below_090 = sum(d$ci_high < 0.9))))
  rp <- comp[comp$design == "main" & comp$method %in% c("rep_sub_100", "rep_sub_500"), ]
  rep_mc <- merge(rp[rp$method == "rep_sub_100", c("lang", "L", "metric", "estimate")],
                  rp[rp$method == "rep_sub_500", c("lang", "L", "metric", "estimate")],
                  by = c("lang", "L", "metric"), suffixes = c("_B100", "_B500"))
  rep_mc$diff_points <- 100 * (rep_mc$estimate_B500 - rep_mc$estimate_B100)

  ## ---- (d): accuracy, whole-novel holdout with full vs halved training ----
  one <- nl10[nl10$design == "main" & nl10$method == "single_sub", ]
  ac <- aggregate(cbind(top1, top1_half, n_chunks) ~ lang + L, data = one, FUN = sum)
  ac$acc_full <- ac$top1 / ac$n_chunks; ac$acc_half <- ac$top1_half / ac$n_chunks
  am7 <- read_sheet(f07, "accuracy_main")[, c("lang", "L", "acc_chunk_mean")]
  acc_size <- merge(ac[, c("lang", "L", "acc_full", "acc_half")], am7, by = c("lang", "L"))
  acc_size$book_effect_full_points <- 100 * (acc_size$acc_chunk_mean - acc_size$acc_full)
  acc_size$book_effect_half_points <- 100 * (acc_size$acc_chunk_mean - acc_size$acc_half)

  ## ---- (f): dispersion checks against author coverage (step07, single subsampling) ----
  hm7 <- read_sheet(f07, "het_main")
  hh <- merge(hm7[, c("lang", "author", "n_novels", "ratio", "covered")], h10[, c("lang", "author", "ratio_alt")],
              by = c("lang", "author"))
  rk <- function(x) (rank(x) - 0.5) / length(x)               # ranks scaled within a language
  hh$ratio_r <- ave(hh$ratio, hh$lang, FUN = rk); hh$cov_r <- ave(hh$covered, hh$lang, FUN = rk)
  sp10 <- function(x, y) tryCatch({ ct <- suppressWarnings(cor.test(x, y, method = "spearman"))
    c(unname(ct$estimate), ct$p.value, length(x)) }, error = function(e) c(NA, NA, length(x)))  # NA if too few authors
  het_checks <- rbind(
    data.frame(check = "pooled, original ratio", t(sp10(hh$ratio, hh$covered))),
    data.frame(check = "pooled, ranks within language", t(sp10(hh$ratio_r, hh$cov_r))),
    data.frame(check = "pooled, authors with 3+ novels", t(sp10(hh$ratio[hh$n_novels >= 3], hh$covered[hh$n_novels >= 3]))),
    data.frame(check = "pooled, alternative ratio (nearest other author)", t(sp10(hh$ratio_alt, hh$covered))),
    do.call(rbind, lapply(LANGS, function(lg) { d <- hh[hh$lang == lg, ]
      rbind(data.frame(check = paste(lg, "original ratio"), t(sp10(d$ratio, d$covered))),
            data.frame(check = paste(lg, "alternative ratio"), t(sp10(d$ratio_alt, d$covered))),
            if (sum(d$n_novels >= 3) >= 5) data.frame(check = paste(lg, "authors with 3+ novels"),
                                                      t(sp10(d$ratio[d$n_novels >= 3], d$covered[d$n_novels >= 3])))) })))
  names(het_checks)[2:4] <- c("spearman_rho", "p_value", "n_authors")

  ## ---- (g): other novels affected by the MFW choice (step06), and the R session ----
  n6 <- read_sheet(f06, "novel_level"); n6 <- n6[n6$method == "cdf_pool", ]
  w6 <- merge(n6[n6$variant == "global", c("lang", "L", "novel", "n_chunks", "covered")],
              n6[n6$variant == "fold", c("lang", "L", "novel", "covered")], by = c("lang", "L", "novel"),
              suffixes = c("_global", "_fold"))
  w6$abs_change <- abs(w6$covered_fold - w6$covered_global)
  o6 <- w6[!grepl("Feval", w6$novel), ]
  mfw_others <- data.frame(statistic = c("novels x lengths compared (excluding Feval)",
                                         "with any change in covered chunks",
                                         "largest change in covered chunks",
                                         "largest change as share of the novel's chunks"),
                           value = c(nrow(o6), sum(o6$abs_change > 0), max(o6$abs_change),
                                     round(max(o6$abs_change / o6$n_chunks), 3)))
  pk <- c("openxlsx", "readxl", "xml2", "jsonlite", "ggplot2", "ggrepel")
  session <- data.frame(item = c("R", "platform", pk),
                        value = c(R.version.string, R.version$platform,
                                  sapply(pk, function(p) tryCatch(as.character(packageVersion(p)), error = function(e) "not installed"))))

  save6(list(comparability = comp, comparability_diff = comp_diff, comparability_summary = comp_summary,
             rep_sub_B100_vs_B500 = rep_mc, accuracy_training_size = acc_size, het_checks = het_checks,
             het_alt_ratio = hh, mfw_other_novels = mfw_others, session = session, novel_level = nl10,
             settings = data.frame(item = c("seed_step10", "minutes"),
                                   value = c("2034/2035", round(as.numeric(difftime(Sys.time(), t10, units = "mins")), 1)))),
        f10, prefix = "step10_")
  print(comp_summary); print(het_checks); print(mfw_others)
  cat("STEP 10 minutes:", round(as.numeric(difftime(Sys.time(), t10, units = "mins")), 1), "\n")
} else cat("STEP 10 skipped: step10_results.xlsx already exists\n")

## =====================================================================
