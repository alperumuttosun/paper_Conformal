f06 <- file.path(out_dir, "step06_results.xlsx")             # step06 output file
if (!file.exists(f06)) {
  t06 <- Sys.time()
  nov6 <- list(); acc_rows <- list(); het_rows <- list(); seed_rows <- list(); ovl_rows <- list()
  for (lang in LANGS) {
    set.seed(2029)                                            # step06 seed (per language)
    lc <- lang_corpus6(lang); cl <- lc$cl; tk <- lc$tk
    vc <- voc6(cl, tk)
    ## (a) how many of the 200 words change when the test novel is excluded
    ovl <- sapply(rownames(vc$NV), function(m) length(intersect(seq_len(N_MFW), mfw_idx6(vc$NV, m, "fold"))))
    ovl_rows[[lang]] <- data.frame(lang = lang, n_folds = length(ovl), overlap_min = min(ovl),
                                   overlap_mean = mean(ovl), overlap_max = max(ovl),
                                   folds_identical = sum(ovl == N_MFW))
    for (L in L_set) {
      cat(lang, "L =", L, "|", format(round(difftime(Sys.time(), t06, units = "mins"), 1)), "\n")
      bc <- chunks6(cl, tk, vc$V, L)
      ## (a)-(d) both MFW variants, all four procedures
      nov6[[length(nov6) + 1]] <- closed6(bc, vc$NV, lang, L, c("global", "fold"), M_ALL6)
      ## (e) chunk-split accuracy, 20 repeats
      acc_rows[[length(acc_rows) + 1]] <- data.frame(lang = lang, L = L, rep = seq_len(N_SPLIT6),
                                                     accuracy = acc6(bc))
      ## (g) dispersion ratio at this length
      het_rows[[length(het_rows) + 1]] <- het6(bc, cl, lang, L)
    }
    ## (f) five random chunk selections (global MFW, procedures without rep_sub)
    for (sd6 in SEEDS6) {
      set.seed(sd6)
      for (L in L_set) {
        bc <- chunks6(cl, tk, vc$V, L)
        r <- closed6(bc, vc$NV, lang, L, "global", c("naive", "single_sub", "cdf_pool"))
        r$seed <- sd6; seed_rows[[length(seed_rows) + 1]] <- r
      }
    }
    rm(lc, cl, tk, vc, bc); invisible(gc())
  }
  nov6 <- do.call(rbind, nov6)
  acc_r <- do.call(rbind, acc_rows); het_r <- do.call(rbind, het_rows)
  seed_r <- do.call(rbind, seed_rows); ovl_r <- do.call(rbind, ovl_rows)
  cat("Analyses done, bootstrap starts |", format(round(difftime(Sys.time(), t06, units = "mins"), 1)), "\n")

  ## ---- (a)-(c) weighted estimates, novel and author bootstrap ----
  set.seed(2030)
  cells <- split(nov6, list(nov6$lang, nov6$L, nov6$variant, nov6$method), drop = TRUE)
  wt <- do.call(rbind, lapply(cells, function(g) {
    rbind(cbind(g[1, c("lang", "L", "variant", "method")], boot_w6(g, MET6, "novel"), row.names = NULL),
          cbind(g[1, c("lang", "L", "variant", "method")], boot_w6(g, MET6, "author"), row.names = NULL))
  }))
  rownames(wt) <- NULL

  ## (a) global vs fold MFW, chunk weight, novel bootstrap (the step04 definition)
  mc <- wt[wt$cluster == "novel" & wt$weight == "chunk", ]
  mfw_cmp <- merge(mc[mc$variant == "global", c("lang", "L", "method", "metric", "estimate")],
                   mc[mc$variant == "fold",   c("lang", "L", "method", "metric", "estimate")],
                   by = c("lang", "L", "method", "metric"), suffixes = c("_global", "_fold"))
  mfw_cmp$diff_points <- 100 * (mfw_cmp$estimate_fold - mfw_cmp$estimate_global)  # percentage points

  ## (d) calibration pool per fold, and coverage for 2-novel vs 3+ authors
  pool <- unique(nov6[nov6$variant == "global", c("lang", "L", "novel", "n_auth", "n_cal_novels", "n_train_novels")])
  pool$dropped <- pool$n_train_novels - pool$n_cal_novels    # training novels without a cross-fit score
  calib_pool <- do.call(rbind, lapply(split(pool, list(pool$lang, pool$L), drop = TRUE), function(d)
    data.frame(lang = d$lang[1], L = d$L[1], n_folds = nrow(d),
               cal_min = min(d$n_cal_novels), cal_mean = mean(d$n_cal_novels), cal_max = max(d$n_cal_novels),
               folds_with_drop = sum(d$dropped > 0), max_dropped = max(d$dropped),
               folds_test_author_2novels = sum(d$n_auth == 2))))
  g2 <- nov6[nov6$variant == "global", ]
  g2$ntype <- ifelse(g2$n_auth == 2, "2 novels", "3+ novels")
  cov_nt <- do.call(rbind, lapply(split(g2, list(g2$lang, g2$L, g2$method, g2$ntype), drop = TRUE), function(g)
    cbind(g[1, c("lang", "L", "method", "ntype")],
          boot_w6(g, c("covered", "set_size"), "novel")[c(1, 2, 3, 4), ], row.names = NULL)))  # chunk & novel weight

  ## (e) accuracy: chunk split (20 repeats) vs held-out novels
  bk <- wt[wt$variant == "global" & wt$method == "single_sub" & wt$metric == "top1" &
           wt$cluster == "novel" & wt$weight == "chunk", c("lang", "L", "estimate", "ci_low", "ci_high")]
  names(bk)[3:5] <- c("acc_book_level", "acc_book_ci_low", "acc_book_ci_high")
  ch <- do.call(rbind, lapply(split(acc_r, list(acc_r$lang, acc_r$L), drop = TRUE), function(d)
    data.frame(lang = d$lang[1], L = d$L[1], n_split = nrow(d), acc_chunk_mean = mean(d$accuracy),
               acc_chunk_sd = sd(d$accuracy), acc_chunk_q025 = unname(quantile(d$accuracy, 0.025)),
               acc_chunk_q975 = unname(quantile(d$accuracy, 0.975)))))
  acc20 <- merge(bk, ch, by = c("lang", "L"))
  acc20$drop_points <- 100 * (acc20$acc_chunk_mean - acc20$acc_book_level)

  ## (f) seeds: chunk-weighted estimates per seed, then range
  sagg <- aggregate(cbind(covered, set_size, singleton, n_chunks) ~ lang + L + method + seed, data = seed_r, FUN = sum)
  for (v in c("covered", "set_size", "singleton")) sagg[[v]] <- sagg[[v]] / sagg$n_chunks
  sagg$n_chunks <- NULL
  srange <- do.call(rbind, lapply(split(sagg, list(sagg$lang, sagg$L, sagg$method), drop = TRUE), function(d)
    data.frame(lang = d$lang[1], L = d$L[1], method = d$method[1], n_seeds = nrow(d),
               cov_min = min(d$covered), cov_max = max(d$covered),
               cov_range_points = 100 * diff(range(d$covered)),
               size_min = min(d$set_size), size_max = max(d$set_size),
               single_min = min(d$singleton), single_max = max(d$singleton))))

  ## (g) dispersion at every length vs author coverage (same length, and pooled over lengths)
  ss <- g2[g2$method == "single_sub", ]
  covL <- aggregate(cbind(covered, n_chunks) ~ lang + L + author, data = ss, FUN = sum)
  covL$cov_L <- covL$covered / covL$n_chunks
  covP <- aggregate(cbind(covered, n_chunks) ~ lang + author, data = ss, FUN = sum)
  covP$cov_pooled <- covP$covered / covP$n_chunks
  hetL <- merge(het_r[het_r$author %in% unique(ss$author), ],
                covL[, c("lang", "L", "author", "cov_L")], by = c("lang", "L", "author"))
  hetL <- merge(hetL, covP[, c("lang", "author", "cov_pooled")], by = c("lang", "author"))
  sp <- function(x, y) { ct <- suppressWarnings(cor.test(x, y, method = "spearman")); c(unname(ct$estimate), ct$p.value) }
  het_cor <- do.call(rbind, lapply(L_set, function(L) {
    d <- hetL[hetL$L == L, ]
    do.call(rbind, lapply(c("pooled", LANGS), function(lg) {
      e <- if (lg == "pooled") d else d[d$lang == lg, ]
      a <- sp(e$ratio, e$cov_L); b <- sp(e$ratio, e$cov_pooled)
      data.frame(L = L, lang = lg, n_authors = nrow(e), rho_same_L = a[1], p_same_L = a[2],
                 rho_pooled_cov = b[1], p_pooled_cov = b[2])
    }))
  }))
  ratio_rank <- do.call(rbind, lapply(split(hetL, hetL$lang), function(d) {   # stability of author ranks across L
    w <- reshape(d[, c("author", "L", "ratio")], idvar = "author", timevar = "L", direction = "wide")
    r <- suppressWarnings(cor(w[, -1], method = "spearman", use = "pairwise.complete.obs"))
    data.frame(lang = d$lang[1], min_rank_cor_between_L = min(r[upper.tri(r)]),
               mean_rank_cor_between_L = mean(r[upper.tri(r)]))
  }))

  ## ---- output ----
  settings6 <- data.frame(item = c("LANGS", "N_MFW", "N_VOC6", "B_REP6", "N_SPLIT6", "SEEDS6", "B_BOOT", "seed_step06",
                                   "minutes"),
                          value = c(paste(LANGS, collapse = ","), N_MFW, N_VOC6, B_REP6, N_SPLIT6,
                                    paste(SEEDS6, collapse = ","), B_BOOT, "2029/2030",
                                    round(as.numeric(difftime(Sys.time(), t06, units = "mins")), 1)))
  save6(list(mfw_overlap = ovl_r, mfw_compare = mfw_cmp, weighting = wt, calib_pool = calib_pool,
             cov_by_ntype = cov_nt, accuracy20 = acc20, seeds_range = srange, seeds_raw = sagg,
             het_by_L = hetL, het_cor_by_L = het_cor, het_rank_stability = ratio_rank,
             novel_level = nov6, settings = settings6), f06)
  print(ovl_r); print(calib_pool)
  print(mfw_cmp[mfw_cmp$metric == "covered", c("lang", "L", "method", "estimate_global", "estimate_fold", "diff_points")])
  cat("STEP 06 minutes:", round(as.numeric(difftime(Sys.time(), t06, units = "mins")), 1), "\n")
} else cat("STEP 06 skipped: step06_results.xlsx already exists\n")

## =====================================================================
## STEP 07 - Main closed-set results with MFW chosen inside each fold
##  Reads step06_results.xlsx (no re-analysis of the closed set). The open set stays from step04:
##  outsider novels never entered the MFW selection, so their MFW list is already fold-free.
##  Also lists the novels whose result changes with the MFW choice and the words behind it.
## Output: step07_main_results.xlsx
## =====================================================================
f07 <- file.path(out_dir, "step07_main_results.xlsx")         # step07 output file
if (!file.exists(f07)) {
  set.seed(2031)                                              # step07 seed (bootstraps)
  nl  <- read_sheet(f06, "novel_level")                       # novel-level rows, both MFW variants
  wt6 <- read_sheet(f06, "weighting")                         # weighted estimates with CIs
  a20 <- read_sheet(f06, "accuracy20")                        # chunk-split accuracy, 20 repeats
  hL  <- read_sheet(f06, "het_by_L")                          # dispersion ratio at every length
  fo  <- nl[nl$variant == "fold", ]                           # main analysis from now on

  ## ---- (a) closed set: chunk-weighted, novel bootstrap (same definition as step04) ----
  sel <- wt6$variant == "fold" & wt6$cluster == "novel" & wt6$weight == "chunk"
  closed_main <- wt6[sel & wt6$metric %in% c("covered", "set_size", "singleton", "empty"),
                     c("lang", "L", "method", "metric", "estimate", "ci_low", "ci_high", "n_novels")]

  ## ---- (b) accuracy: held-out novels (fold MFW) vs chunk split (20 repeats) ----
  bk <- wt6[sel & wt6$metric == "top1" & wt6$method == "single_sub", c("lang", "L", "estimate", "ci_low", "ci_high")]
  names(bk)[3:5] <- c("acc_book_level", "acc_book_ci_low", "acc_book_ci_high")
  accuracy_main <- merge(bk, a20[, c("lang", "L", "n_split", "acc_chunk_mean", "acc_chunk_sd",
                                     "acc_chunk_q025", "acc_chunk_q975")], by = c("lang", "L"))
  accuracy_main$acc_chunk_level <- accuracy_main$acc_chunk_mean      # name used by the figure code
  accuracy_main$drop <- accuracy_main$acc_chunk_level - accuracy_main$acc_book_level  # book effect

  ## ---- (c) author coverage (fold MFW, single subsampling) and dispersion ratio ----
  ss <- fo[fo$method == "single_sub", ]
  cP <- aggregate(cbind(covered, n_chunks) ~ lang + author, data = ss, FUN = sum)   # pooled over lengths
  cP$covered <- cP$covered / cP$n_chunks
  cL <- aggregate(cbind(covered, n_chunks) ~ lang + L + author, data = ss, FUN = sum)  # per length
  cL$cov_L <- cL$covered / cL$n_chunks
  het_main <- merge(hL[hL$L == L_HET, c("lang", "author", "n_novels", "within", "between", "ratio")],
                    cP[, c("lang", "author", "covered")], by = c("lang", "author"))
  sp7 <- function(x, y) { ct <- suppressWarnings(cor.test(x, y, method = "spearman")); c(unname(ct$estimate), ct$p.value) }
  het_cor_main <- do.call(rbind, lapply(c("pooled", LANGS), function(lg) {
    d <- if (lg == "pooled") het_main else het_main[het_main$lang == lg, ]
    r <- sp7(d$ratio, d$covered)
    data.frame(lang = lg, n_authors = nrow(d), spearman_rho = r[1], p_value = r[2])
  }))
  hLf <- merge(hL[, c("lang", "L", "author", "ratio")], cL[, c("lang", "L", "author", "cov_L")],
               by = c("lang", "L", "author"))
  hLf <- merge(hLf, cP[, c("lang", "author", "covered")], by = c("lang", "author"))
  het_cor_by_L <- do.call(rbind, lapply(L_set, function(L) do.call(rbind, lapply(c("pooled", LANGS), function(lg) {
    d <- hLf[hLf$L == L & (lg == "pooled" | hLf$lang == lg), ]
    a <- sp7(d$ratio, d$cov_L); b <- sp7(d$ratio, d$covered)
    data.frame(L = L, lang = lg, n_authors = nrow(d), rho_same_L = a[1], p_same_L = a[2],
               rho_pooled_cov = b[1], p_pooled_cov = b[2])
  }))))

  ## ---- (d) coverage for 2-novel vs 3+ novel authors (fold MFW) ----
  fo$ntype <- ifelse(fo$n_auth == 2, "2 novels", "3+ novels")
  cov_by_ntype <- do.call(rbind, lapply(split(fo, list(fo$lang, fo$L, fo$method, fo$ntype), drop = TRUE), function(g)
    cbind(g[1, c("lang", "L", "method", "ntype")],
          boot_w6(g, c("covered", "set_size"), "novel")[1:4, ], row.names = NULL)))  # chunk and novel weight

  ## ---- (e) novels whose result changes with the MFW choice, and the words behind it ----
  cs <- nl[nl$method == "cdf_pool", c("lang", "L", "variant", "novel", "author", "n_chunks", "covered", "top1")]
  w2 <- merge(cs[cs$variant == "global", -3], cs[cs$variant == "fold", -3],
              by = c("lang", "L", "novel", "author", "n_chunks"), suffixes = c("_global", "_fold"))
  w2$d_covered <- w2$covered_fold - w2$covered_global
  mfw_novel_diff <- w2[abs(w2$d_covered) >= pmax(3, 0.2 * w2$n_chunks), ]  # large changes only
  mfw_novel_diff <- mfw_novel_diff[order(mfw_novel_diff$lang, -abs(mfw_novel_diff$d_covered)), ]
  word_rows <- list()
  for (lg in unique(mfw_novel_diff$lang)) {                   # vocabulary only for languages concerned
    lc <- lang_corpus6(lg); vc <- voc6(lc$cl, lc$tk)
    for (m in unique(mfw_novel_diff$novel[mfw_novel_diff$lang == lg])) {
      gi <- seq_len(N_MFW); fi <- mfw_idx6(vc$NV, m, "fold")
      for (j in c(setdiff(gi, fi), setdiff(fi, gi)))
        word_rows[[length(word_rows) + 1]] <- data.frame(lang = lg, novel = m, word = vc$V[j],
          in_list = if (j %in% gi) "global only" else "fold only",
          count_all_candidates = sum(vc$NV[, j]), count_this_novel = vc$NV[m, j])
    }
    rm(lc, vc); invisible(gc())
  }
  mfw_word_diff <- if (length(word_rows)) do.call(rbind, word_rows) else
    data.frame(lang = character(0), novel = character(0), word = character(0))

  ## ---- (f) global vs fold MFW, compact table for the supplementary material ----
  mc <- read_sheet(f06, "mfw_compare")
  mfw_supp <- mc[mc$metric %in% c("covered", "set_size", "top1"), ]

  ## ---- output (Option A xlsx, Option B csv) ----
  save6(list(closed_main = closed_main, accuracy_main = accuracy_main, het_main = het_main,
             het_cor_main = het_cor_main, het_cor_by_L = het_cor_by_L, cov_by_ntype = cov_by_ntype,
             mfw_novel_diff = mfw_novel_diff, mfw_word_diff = mfw_word_diff, mfw_supp = mfw_supp,
             settings = data.frame(item = c("MFW", "source", "seed_step07"),
                                   value = c("chosen inside each fold (test novel excluded)",
                                             "step06_results.xlsx", 2031))),
        f07, prefix = "step07_")
  print(het_cor_main); print(mfw_novel_diff); print(mfw_word_diff)
} else cat("STEP 07 skipped: step07_main_results.xlsx already exists\n")

## =====================================================================
## STEP 08 - Author-specific (Mondrian) thresholds in all three languages
##  Same design as the main analysis: whole novels held out, MFW chosen inside each fold,
##  cross-fit calibration scores. Two versions:
##    mondrian_book  : per-author threshold from one random chunk per calibration novel
##    mondrian_chunk : per-author threshold from all chunks (ignores within-novel dependence)
## Output: step08_mondrian.xlsx
## =====================================================================
f08 <- file.path(out_dir, "step08_mondrian.xlsx")             # step08 output file
if (!file.exists(f08)) {
  t08 <- Sys.time(); rows8 <- list()
  for (lang in LANGS) {
    set.seed(2032)                                            # step08 seed (per language)
    lc <- lang_corpus6(lang); vc <- voc6(lc$cl, lc$tk)        # cached corpus, no download
    for (L in L_set) {
      cat("STEP 08", lang, "L =", L, "|", format(round(difftime(Sys.time(), t08, units = "mins"), 1)), "\n")
      bc <- chunks6(lc$cl, lc$tk, vc$V, L); meta <- bc$meta
      for (nstar in rownames(vc$NV)) {                        # every candidate novel held out once
        te <- which(meta$id == nstar); if (length(te) == 0) next
        tr <- meta$id != nstar; trc <- tr & meta$role == "candidate"
        ta <- meta$author[te[1]]                              # true author
        Z <- zfit3(bc$CV[, mfw_idx6(vc$NV, nstar, "fold"), drop = FALSE], tr)  # fold MFW, z-scores
        cb <- calib4(Z, trc, meta)                            # profiles and cross-fit scores
        if (!(ta %in% rownames(cb$P))) next
        D <- cosd(Z[te, , drop = FALSE], cb$P)                # test distances
        one <- pick_one(cb$novel)                             # one chunk per calibration novel
        q_mch <- tapply(cb$s, cb$auth, qconf, a = ALPHA)[colnames(D)]   # per author, all chunks
        q_mch[is.na(q_mch)] <- Inf                            # author without scores -> always included
        q_mbk <- sapply(colnames(D), function(a) qconf(cb$s[one][cb$auth[one] == a], ALPHA))  # per author, one per novel
        n_cal_a <- sapply(colnames(D), function(a) sum(cb$auth[one] == a))  # calibration novels per author
        sets <- list(mondrian_chunk = sweep(D, 2, q_mch, "<="),
                     mondrian_book  = sweep(D, 2, q_mbk, "<="))
        hit <- sum(top1(D) == ta)
        for (m in names(sets)) {
          k <- rowSums(sets[[m]])                             # set size per chunk
          rows8[[length(rows8) + 1]] <- data.frame(
            lang = lang, L = L, method = m, novel = nstar, author = ta,
            n_auth = meta$n_auth[te[1]], n_chunks = length(te),
            covered = sum(sets[[m]][, ta]), set_size = sum(k), singleton = sum(k == 1),
            empty = sum(k == 0), full_set = sum(k == ncol(D)), top1 = hit,
            n_authors = ncol(D), max_cal_novels_per_author = max(n_cal_a),
            stringsAsFactors = FALSE)
        }
      }
    }
    rm(lc, vc, bc); invisible(gc())
  }
  nl8 <- do.call(rbind, rows8)

  ## ---- overall results: chunk-weighted, novel bootstrap (same definition as step07) ----
  set.seed(2033)
  M8 <- c("covered", "set_size", "singleton", "empty", "full_set")
  cells8 <- split(nl8, list(nl8$lang, nl8$L, nl8$method), drop = TRUE)
  mond <- do.call(rbind, lapply(cells8, function(g)
    cbind(g[1, c("lang", "L", "method")], boot_w6(g, M8, "novel")[1:length(M8), ], row.names = NULL)))
  rownames(mond) <- NULL

  ## ---- author-level coverage pooled over lengths, next to single subsampling (step07) ----
  ca8 <- aggregate(cbind(covered, n_chunks) ~ lang + author + method, data = nl8, FUN = sum)
  ca8$cov <- ca8$covered / ca8$n_chunks
  w8 <- reshape(ca8[, c("lang", "author", "method", "cov")], idvar = c("lang", "author"),
                timevar = "method", direction = "wide")
  h7 <- read_sheet(f07, "het_main")                           # single subsampling + dispersion ratio
  by_author <- merge(h7[, c("lang", "author", "n_novels", "ratio", "covered")], w8, by = c("lang", "author"))
  names(by_author)[names(by_author) == "covered"] <- "cov.single_sub"
  by_author <- by_author[order(by_author$lang, by_author$cov.single_sub), ]
  spread <- do.call(rbind, lapply(c("cov.single_sub", "cov.mondrian_chunk", "cov.mondrian_book"), function(v)
    data.frame(method = sub("cov.", "", v), min_author_cov = min(by_author[[v]]),
               max_author_cov = max(by_author[[v]]), sd_author_cov = sd(by_author[[v]]),
               authors_below_085 = sum(by_author[[v]] < 0.85))))

  save6(list(mondrian_closed = mond, mondrian_by_author = by_author, author_spread = spread,
             novel_level = nl8,
             settings = data.frame(item = c("MFW", "seed_step08", "minutes"),
                                   value = c("chosen inside each fold", "2032/2033",
                                             round(as.numeric(difftime(Sys.time(), t08, units = "mins")), 1)))),
        f08, prefix = "step08_")
  print(spread)
  print(mond[mond$metric %in% c("covered", "full_set"), c("lang", "L", "method", "metric", "estimate")])
} else cat("STEP 08 skipped: step08_mondrian.xlsx already exists\n")

## =====================================================================
