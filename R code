  }
  cl4  <- do.call(rbind, lapply(R4, `[[`, "closed"))            # closed-set rows
  op4  <- do.call(rbind, lapply(R4, `[[`, "open"))              # open-set rows
  ac4  <- do.call(rbind, lapply(R4, `[[`, "acc"))               # chunk-split accuracy
  het4 <- do.call(rbind, lapply(R4, `[[`, "het"))               # heterogeneity per author
  inf4 <- do.call(rbind, lapply(R4, `[[`, "info"))              # corpus sizes

  ## ---- summaries with novel-level bootstrap CIs, per language ----
  boot_lang <- function(df, metrics) do.call(rbind, lapply(split(df, df$lang), function(d)
    cbind(lang = d$lang[1], boot_ci(d, metrics))))              # boot_ci from step03, per language
  b4_closed <- boot_lang(cl4, c("covered", "set_size", "singleton", "empty"))
  b4_open   <- boot_lang(op4, c("empty", "false_single", "set_size"))
  b4_top1   <- boot_lang(cl4[cl4$method == "single_sub", ], "top1")  # book-level accuracy
  ch4 <- aggregate(accuracy ~ lang + L, data = ac4, FUN = mean)  # chunk-level accuracy
  acc4 <- merge(b4_top1[, c("lang", "L", "estimate", "ci_low", "ci_high")], ch4, by = c("lang", "L"))
  names(acc4) <- c("lang", "L", "acc_book_level", "acc_book_ci_low", "acc_book_ci_high", "acc_chunk_level")
  acc4$drop <- acc4$acc_chunk_level - acc4$acc_book_level       # book effect on accuracy

  ## ---- (c) author coverage vs heterogeneity ----
  au4 <- aggregate(covered ~ lang + author, data = cl4[cl4$method == "single_sub", ], FUN = mean)  # coverage, all L
  het4 <- merge(het4, au4, by = c("lang", "author"))            # join
  hc <- function(d) {                                           # Spearman correlation and test
    ct <- suppressWarnings(cor.test(d$ratio, d$covered, method = "spearman"))
    data.frame(n_authors = nrow(d), spearman_rho = unname(ct$estimate), p_value = ct$p.value)
  }
  het_cor <- rbind(cbind(lang = "pooled", hc(het4)),
                   do.call(rbind, lapply(split(het4, het4$lang), function(d) cbind(lang = d$lang[1], hc(d)))))

  ## ---- step04 output ----
  wb4 <- createWorkbook()
  addWorksheet(wb4, "corpus_info");      writeData(wb4, "corpus_info", inf4)
  addWorksheet(wb4, "closed_boot");      writeData(wb4, "closed_boot", b4_closed)
  addWorksheet(wb4, "open_boot");        writeData(wb4, "open_boot", b4_open)
  addWorksheet(wb4, "accuracy_book_effect"); writeData(wb4, "accuracy_book_effect", acc4)
  addWorksheet(wb4, "heterogeneity");    writeData(wb4, "heterogeneity", het4[order(het4$lang, het4$covered), ])
  addWorksheet(wb4, "heterogeneity_cor"); writeData(wb4, "heterogeneity_cor", het_cor)
  addWorksheet(wb4, "settings")
  writeData(wb4, "settings", data.frame(item = c("LANGS", "B_REP4", "N_SPLIT4", "L_HET", "seed_step04"),
                                        value = c(paste(LANGS, collapse = ","), B_REP4, N_SPLIT4, L_HET, 2028)))
  saveWorkbook(wb4, file.path(out_dir, "step04_results.xlsx"), overwrite = TRUE)  # save
  print(inf4); print(het_cor)                                   # console check
  print(b4_closed[b4_closed$metric == "covered", c("lang", "L", "method", "estimate", "ci_low", "ci_high")])
} else cat("STEP 04 skipped: step04_results.xlsx already exists\n")

