## STEP 06 - Robustness analyses
##  (a) MFW chosen inside each fold (test novel excluded) vs global MFW
##  (b) coverage weighted by chunk, by novel and by author
##  (c) bootstrap that resamples novels vs one that resamples authors
##  (d) calibration pool size per fold; coverage for 2-novel vs 3+ authors
##  (e) chunk-split accuracy with 20 repeats
##  (f) five random chunk selections (seeds)
##  (g) dispersion ratio at every chunk length
## Reads the cached corpora (no download). Output: step06_results.xlsx
## =====================================================================
B_REP6   <- 100                                               # subsamples for rep_sub (as step04)
N_SPLIT6 <- 20                                                # repeats of the chunk-level split
SEEDS6   <- c(101, 202, 303, 404, 505)                        # seeds for chunk selection
N_VOC6   <- 1000                                              # vocabulary from which fold MFW are drawn
M_ALL6   <- c("naive", "single_sub", "cdf_pool", "rep_sub")   # conformal procedures
MET6     <- c("covered", "set_size", "singleton", "empty", "top1")  # summed per novel

## ---- corpus of one language from the caches (English from step01, others from step04) ----
lang_corpus6 <- function(lang) {
  if (lang == "eng") {
    cl <- corp[, c("id", "author")]; tk <- toks               # already tokenized above
  } else {
    cl <- get_corpus(lang)                                    # reads step04 cache, no download
    tk <- lapply(cl$text, tok_l); names(tk) <- cl$id          # tokens
    cl <- cl[, c("id", "author")]                             # drop text to save memory
  }
  an <- table(cl$author)                                      # novels per author
  cl$role   <- ifelse(cl$author %in% names(an)[an >= 2], "candidate", "outsider")  # same rule as step04
  cl$n_auth <- as.vector(an[cl$author])                       # novels of this author
  list(cl = cl, tk = tk)
}

## ---- vocabulary: top N_VOC6 words of the candidate novels + counts per candidate novel ----
voc6 <- function(cl, tk) {
  cand <- cl$id[cl$role == "candidate"]                       # candidate novels
  V <- names(sort(table(unlist(tk[cand], use.names = FALSE)), decreasing = TRUE))[1:N_VOC6]  # V[1:200] = global MFW
  NV <- t(sapply(cand, function(id) tabulate(match(tk[[id]], V), nbins = N_VOC6)))  # novel x word counts
  rownames(NV) <- cand
  list(V = V, NV = NV)
}

## ---- chunks of one length: relative frequencies of all N_VOC6 words ----
chunks6 <- function(cl, tk, V, L) {
  ch_list <- lapply(cl$id, function(id) make_chunks(tk[[id]], L, CAP))  # same chunking as step04
  n_ch <- lengths(ch_list)                                    # chunks per novel
  meta <- data.frame(id = rep(cl$id, n_ch), author = rep(cl$author, n_ch),
                     role = rep(cl$role, n_ch), n_auth = rep(cl$n_auth, n_ch),
                     stringsAsFactors = FALSE)                # chunk metadata
  CV <- do.call(rbind, lapply(unlist(ch_list, recursive = FALSE),
          function(ch) tabulate(match(ch, V), nbins = length(V)))) / L  # chunk x word frequencies
  list(CV = CV, meta = meta)
}

## ---- MFW column index for one fold: global list or list without the test novel ----
mfw_idx6 <- function(NV, nstar, variant) {
  if (variant == "global") return(seq_len(N_MFW))            # V is sorted, so 1:200 = global MFW
  order(-(colSums(NV) - NV[nstar, ]))[1:N_MFW]                # top 200 without the test novel
}

## ---- closed set, leave one novel out; returns one row per novel x variant x method ----
closed6 <- function(bc, NV, lang, L, variants, methods) {
  meta <- bc$meta; out <- list()
  for (nstar in rownames(NV)) {                               # every candidate novel is tested once
    te <- which(meta$id == nstar); if (length(te) == 0) next  # novel too short for this length
    tr <- meta$id != nstar                                    # training rows
    trc <- tr & meta$role == "candidate"                      # candidate training rows
    ta <- meta$author[te[1]]                                  # true author
    for (v in variants) {
      Z <- zfit3(bc$CV[, mfw_idx6(NV, nstar, v), drop = FALSE], tr)  # z-scores from training rows
      cb <- calib4(Z, trc, meta)                              # profiles, naive and cross-fit scores
      if (!(ta %in% rownames(cb$P))) next                     # author has no other novel
      D <- cosd(Z[te, , drop = FALSE], cb$P)                  # test distances
      sets <- list()
      if ("naive" %in% methods)      sets$naive      <- D <= qconf(cb$s_naive, ALPHA)
      if ("single_sub" %in% methods) sets$single_sub <- D <= qconf(cb$s[pick_one(cb$novel)], ALPHA)
      if ("cdf_pool" %in% methods)   sets$cdf_pool   <- D <= qpool(cb$s, cb$novel, ALPHA)
      if ("rep_sub" %in% methods) {
        psum <- 0
        for (b in seq_len(B_REP6)) psum <- psum + pval_mat(D, cb$s[pick_one(cb$novel)])  # average p-values
        sets$rep_sub <- (psum / B_REP6) >= ALPHA
      }
      hit <- sum(top1(D) == ta)                               # nearest-profile hits
      n_cal <- length(unique(cb$novel))                       # novels in the calibration pool
      n_trn <- length(unique(meta$id[trc]))                   # candidate training novels
      for (m in names(sets)) {
        k <- rowSums(sets[[m]])                               # set size per chunk
        out[[length(out) + 1]] <- data.frame(
          lang = lang, L = L, variant = v, method = m, novel = nstar, author = ta,
          n_auth = meta$n_auth[te[1]], n_chunks = length(te),
          covered = sum(sets[[m]][, ta]), set_size = sum(k), singleton = sum(k == 1),
          empty = sum(k == 0), top1 = hit, n_cal_novels = n_cal, n_train_novels = n_trn,
          stringsAsFactors = FALSE)
      }
    }
  }
  do.call(rbind, out)
}

## ---- chunk-level split accuracy (half of every candidate novel in test), global MFW ----
acc6 <- function(bc) {
  meta <- bc$meta; X <- bc$CV[, seq_len(N_MFW)]
  cr <- which(meta$role == "candidate")
  sapply(seq_len(N_SPLIT6), function(r) {
    te <- unlist(tapply(cr, meta$id[cr], function(v) v[sample.int(length(v), floor(length(v) / 2))]),
                 use.names = FALSE)                           # half of each novel to test
    tr <- !(seq_len(nrow(meta)) %in% te); Z <- zfit3(X, tr)
    trc <- tr & meta$role == "candidate"
    S <- rowsum(Z[trc, , drop = FALSE], meta$author[trc])
    P <- S / as.vector(table(meta$author[trc])[rownames(S)])  # profiles incl. the same novel
    mean(top1(cosd(Z[te, , drop = FALSE], P)) == meta$author[te])
  })
}

## ---- dispersion ratio per author at one length (same definition as step04) ----
het6 <- function(bc, cl, lang, L) {
  meta <- bc$meta; cand <- meta$role == "candidate"
  Za <- zfit3(bc$CV[, seq_len(N_MFW)], cand)                  # z-scores from candidate chunks
  NP <- rowsum(Za[cand, , drop = FALSE], meta$id[cand])
  NP <- NP / as.vector(table(meta$id[cand])[rownames(NP)])    # novel mean profiles
  Dn <- cosd(NP, NP)                                          # novel x novel distance
  na <- cl$author[match(rownames(NP), cl$id)]
  do.call(rbind, lapply(unique(na), function(a) {
    w <- which(na == a); o <- which(na != a)
    within <- if (length(w) > 1) mean(Dn[w, w][upper.tri(Dn[w, w])]) else NA
    between <- median(Dn[w, o])
    data.frame(lang = lang, L = L, author = a, n_novels = length(w),
               within = within, between = between, ratio = within / between)
  }))
}

## ---- weighted estimates with cluster bootstrap (novels or authors resampled) ----
## g: novel-level rows of one cell; returns chunk-, novel- and author-weighted means
boot_w6 <- function(g, metrics, cluster, B = B_BOOT) {
  S <- as.matrix(g[, metrics, drop = FALSE]); n <- g$n_chunks; au <- g$author
  stat <- function(i, lab) {                                  # i: rows, lab: author label per row
    Si <- S[i, , drop = FALSE]; R <- Si / n[i]                # novel-level rates
    ra <- rowsum(R, lab); ca <- as.vector(rowsum(rep(1, length(lab)), lab))
    c(colSums(Si) / sum(n[i]), colMeans(R), colMeans(ra / ca))  # chunk, novel, author weight
  }
  est <- stat(seq_len(nrow(g)), au)
  rows_a <- split(seq_len(nrow(g)), au); ua <- names(rows_a)
  bs <- replicate(B, {
    if (cluster == "novel") {
      i <- sample.int(nrow(g), replace = TRUE); stat(i, au[i])        # resample novels
    } else {
      a <- ua[sample.int(length(ua), replace = TRUE)]                 # resample authors
      i <- unlist(rows_a[a], use.names = FALSE)
      stat(i, rep(seq_along(a), lengths(rows_a[a])))                  # a redrawn author counts twice
    }
  })
  bs <- matrix(bs, nrow = length(est))
  data.frame(cluster = cluster, weight = rep(c("chunk", "novel", "author"), each = length(metrics)),
             metric = rep(metrics, 3), estimate = est,
             ci_low = apply(bs, 1, quantile, 0.025), ci_high = apply(bs, 1, quantile, 0.975),
             n_novels = nrow(g), n_authors = length(ua), row.names = NULL)
}

## ---- save a list of tables: Option A one xlsx, Option B one csv per table ----
save6 <- function(tabs, f, prefix = "step06_") {
  ok <- tryCatch({
    wb <- createWorkbook()
    for (nm in names(tabs)) { addWorksheet(wb, nm); writeData(wb, nm, tabs[[nm]]) }
    saveWorkbook(wb, f, overwrite = TRUE); TRUE
  }, error = function(e) FALSE)
  if (!ok) for (nm in names(tabs))                            # Option B: csv files in the same folder
    write.csv(tabs[[nm]], file.path(out_dir, paste0(prefix, nm, ".csv")), row.names = FALSE)
  cat("Saved:", if (ok) f else paste0("csv files (", prefix, "*.csv)"), "\n")
}

