  wf  <- wt[wt$variant == "fold", ]                            # main analysis: fold-wise MFW

  ## ---- Table 2: 1,000 and 5,000 words ----
  T2 <- do.call(rbind, lapply(c("eng", "fra", "deu"), function(lg) do.call(rbind, lapply(c(1000, 5000), function(L) {
    g <- function(m, k) sel9(cm, lang = lg, L = L, method = m, metric = k)
    data.frame(Collection = paste0(LANGN[lg], " (", length(unique(sel9(hm, lang = lg)$author)), ")"), Words = format(L, big.mark = ","),
               `Coverage, within-novel` = with(g("naive", "covered"), fci(estimate, ci_low, ci_high)),
