## ---- repair text encoding (fixes "invalid UTF-8" error on Windows) ----
fix_utf8 <- function(x) {
  y <- iconv(x, from = "UTF-8", to = "UTF-8", sub = " ")      # Option A: replace invalid UTF-8 bytes
  bad <- is.na(y)                                             # strings still unreadable
  if (any(bad)) y[bad] <- iconv(x[bad], from = "latin1", to = "UTF-8", sub = " ")  # Option B: read as latin1
  enc2utf8(y)                                                 # mark everything as UTF-8
}
for (v in c("author", "title", "text")) corp[[v]] <- fix_utf8(corp[[v]])  # clean the text columns

## ---- tokenizer: lower case, letters and apostrophes only ----
tok <- function(x) {
  w <- tryCatch(
    gsub("[^\\p{L}']+", " ", tolower(x), perl = TRUE),        # Option A: Unicode letters
    error = function(e) {
      y <- iconv(x, from = "UTF-8", to = "ASCII//TRANSLIT", sub = " ")  # Option B: convert to ASCII
      gsub("[^a-z']+", " ", tolower(y))                       # keep a-z letters only
    })
  w <- strsplit(w, "\\s+")[[1]]                               # split on spaces
  w[nchar(w) > 0]                                             # drop empty tokens
}
