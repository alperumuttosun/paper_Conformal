het5 <- if (use07) read_sheet(f07, "het_main") else read_sheet(f04, "heterogeneity")        # author heterogeneity
inf5 <- read_sheet(f04, "corpus_info")                        # corpus sizes

## ---- fixed labels, colours and shapes (same in every figure) ----
lang_lab <- setNames(sprintf(c("English (%d authors)", "French (%d authors)", "German (%d authors)"),
                             inf5$n_candidate_authors[match(c("eng", "fra", "deu"), inf5$lang)]),
                     c("eng", "fra", "deu"))                  # facet labels
meth_lev <- c("naive", "single_sub", "cdf_pool", "rep_sub")   # method order
meth_lab <- c(naive = "Within-novel calibration (naive)", single_sub = "Single subsampling",
              cdf_pool = "CDF pooling", rep_sub = "Repeated subsampling")  # legend labels
meth_col <- c(naive = "#52514E", single_sub = "#2A78D6", cdf_pool = "#EB6834", rep_sub = "#1BAF7A")  # validated hues + neutral reference
meth_shp <- c(naive = 4, single_sub = 16, cdf_pool = 17, rep_sub = 15)  # second encoding: shape
meth_lty <- c(naive = "dashed", single_sub = "solid", cdf_pool = "solid", rep_sub = "solid")  # third encoding: line type
lang_col <- c(eng = "#6250D6", fra = "#008300", deu = "#E34948")  # language hues (validated, used with shapes)
lang_shp <- c(eng = 16, fra = 17, deu = 15)                   # language shapes
L_breaks <- c(250, 500, 1000, 2000, 5000)                     # x-axis ticks

prep <- function(d) {                                         # factor coding for plots
  d$lang <- factor(d$lang, levels = c("eng", "fra", "deu"), labels = lang_lab[c("eng", "fra", "deu")])
  if ("method" %in% names(d)) d$method <- factor(d$method, levels = meth_lev)
  d
}
th <- theme_bw(base_size = 10) +                              # clean theme, no titles
  theme(panel.grid.minor = element_blank(),                   # recessive grid
        panel.grid.major = element_line(colour = "grey90", linewidth = 0.3),
        strip.background = element_rect(fill = "grey95", colour = "grey70"),
        legend.position = "bottom", legend.title = element_blank(),
        legend.key.width = unit(1.4, "lines"))
x_len <- scale_x_log10(breaks = L_breaks, labels = format(L_breaks, big.mark = ","))  # log text length
sc_meth <- function(drop = FALSE) list(                      # method scales (drop = TRUE hides absent methods)
  scale_colour_manual(values = meth_col, labels = meth_lab, drop = drop),
  scale_shape_manual(values = meth_shp, labels = meth_lab, drop = drop),
  scale_linetype_manual(values = meth_lty, labels = meth_lab, drop = drop))
dodge <- position_dodge(width = 0.12)                         # small horizontal offset on log axis

## ---- save one figure: Option A ggsave, Option B base graphics devices ----
save_fig <- function(p, name, w, h) {
  base <- file.path(fig_dir, name)                            # path without extension
  okA <- tryCatch({
    ggsave(paste0(base, ".pdf"), p, width = w, height = h, units = "in",
           device = if (capabilities("cairo")) cairo_pdf else "pdf")  # vector PDF
    ggsave(paste0(base, ".png"), p, width = w, height = h, units = "in", dpi = 1600)  # 1600 dpi PNG
    ggsave(paste0(base, ".tiff"), p, width = w, height = h, units = "in", dpi = 600,
           compression = "lzw")                               # 600 dpi TIFF for DSH
    TRUE }, error = function(e) { message("Yol A failed for ", name, ": ", conditionMessage(e)); FALSE })
  if (!okA) {                                                 # Option B: open devices directly
    pdf(paste0(base, ".pdf"), width = w, height = h); print(p); dev.off()
    png(paste0(base, ".png"), width = w, height = h, units = "in", res = 1600); print(p); dev.off()
    tiff(paste0(base, ".tiff"), width = w, height = h, units = "in", res = 600, compression = "lzw"); print(p); dev.off()
  }
  cat("saved:", name, "\n")                                   # progress
}

