               check.names = FALSE)
  }))))

  ## ---- S1: closed set, every length and procedure ----
  S1 <- do.call(rbind, lapply(c("eng", "fra", "deu"), function(lg) do.call(rbind, lapply(L_set, function(L)
    do.call(rbind, lapply(names(MN), function(m) {
